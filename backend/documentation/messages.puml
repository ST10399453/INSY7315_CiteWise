@startuml API_DataFlow_Messages
left to right direction
skinparam componentStyle rectangle
skinparam wrapWidth 300
skinparam maxMessageSize 200
title Data Flow: Messages Endpoints (channel: citewise_message)

database "Realtime DB (RTDB)\n/chats, /userChats, /chatMessages" as RTDB
database "Firestore\n(Notifications)" as FS_NOTIF
cloud "Firebase Cloud Messaging\n(FCM Push)" as FCM

package "Endpoints: Messages" {
  top to bottom direction
  component "POST /messages"            as MSG_POST
  component "GET  /messages/:chatId"    as MSG_GET
}

' READs
RTDB -[#2E7D32]-.-> MSG_GET  : READ (messages chronological)

' WRITEs
MSG_POST -[#C62828]-> RTDB    : WRITE (message, ensure chat, mirrors)
MSG_POST -[#C62828]-> FS_NOTIF: WRITE (create message_received notif)
MSG_POST -[#C62828]-> FCM     : WRITE (push to recipient devices)
@enduml
