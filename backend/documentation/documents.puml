@startuml API_DataFlow_Documents
left to right direction
skinparam componentStyle rectangle
skinparam wrapWidth 280
skinparam maxMessageSize 200
title Data Flow: Documents Endpoints

cloud "Cloudflare R2\nuploads/" as R2

package "Endpoints: Documents" {
  top to bottom direction
  component "GET /documents/:documentId/download" as DOC_DL
  component "GET /documents/:documentId/file"     as DOC_STREAM
}

' READs (signed URL + stream)
R2 -[#2E7D32]-.-> DOC_DL    : READ (signed URL)
R2 -[#2E7D32]-.-> DOC_STREAM: READ (bytes)
@enduml
