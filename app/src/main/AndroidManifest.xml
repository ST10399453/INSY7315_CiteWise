<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".CiteWiseApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CiteWise_Mobile"
        tools:targetApi="31">
        <activity
            android:name=".DocumentViewerActivity"
            android:exported="false" />
        <activity
            android:name=".TaskDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".ServiceReviewsActivity"
            android:exported="false" />
        <activity
            android:name=".ServiceReviewsListActivity"
            android:exported="false" />
        <activity
            android:name=".AdminProfileSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".AdminUploadResourcesActivity"
            android:exported="false" />
        <activity
            android:name=".ConsultantProfileSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ConsultantTaskDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".ConsultantTasksActivity"
            android:exported="false" />
        <activity
            android:name=".StudentProfileSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".SelectedChatActivity"
            android:exported="false" />
        <activity
            android:name=".ChatsActivity"
            android:exported="false" />
        <activity
            android:name=".AdminDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".RequestServiceSuccessActivity"
            android:exported="false" />
        <activity
            android:name=".RequestServiceStepsActivity"
            android:exported="false" />
        <activity
            android:name=".RequestDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".RequestsActivity"
            android:exported="false" />
        <activity
            android:name=".ServiceRequestActivity"
            android:exported="false" />
        <activity
            android:name=".StudentDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".ConsultantDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".LoginActivity"
            android:exported="false" />
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>

</manifest>