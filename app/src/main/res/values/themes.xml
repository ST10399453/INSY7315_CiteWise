<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Base.Theme.CiteWise_Mobile" parent="Theme.Material3.DayNight.NoActionBar" />

    <style name="Theme.CiteWise_Mobile" parent="Base.Theme.CiteWise_Mobile" />

    <!-- Rounded pill shape -->
    <style name="Shape_Pill">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!-- Bottom nav indicator -->
    <style name="BottomNavActiveIndicator">
        <item name="android:color">@color/gradient_middle</item>
        <item name="android:alpha">0.12</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
    </style>

    <!-- Toggle group style -->
    <style name="Widget.CiteWise.ToggleGroup" parent="Widget.Material3.MaterialButtonToggleGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="shapeAppearance">@style/Shape_Pill</item>
    </style>

    <!-- Toggle button style -->
    <style name="Widget.CiteWise.ToggleButton.Old" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">20dp</item>

        <!-- Driven entirely by state lists -->
        <item name="backgroundTint">@color/toggle_bg_selector</item>
        <item name="android:textColor">@color/toggle_text_color</item>
        <item name="strokeColor">@color/toggle_stroke_color</item>
        <item name="strokeWidth">1dp</item>
    </style>

</resources>
