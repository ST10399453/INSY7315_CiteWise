<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shadow / outer background -->
    <item android:left="3dp" android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#DADCE0" /> <!-- subtle shadow grey -->
        </shape>
    </item>

    <!-- White button base -->
    <item android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#FFFFFF" /> <!-- main button color -->
            <stroke
                android:width="1dp"
                android:color="#E0E0E0"/> <!-- light border -->
        </shape>
    </item>

    <!-- Optional gradient overlay for slight depth -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:startColor="#FFFFFFFF"
                android:endColor="#FFF8F9FA"
                android:angle="270" />
        </shape>
    </item>

</layer-list>
