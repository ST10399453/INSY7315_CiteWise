    <!-- Subtle outline to pop on light backgrounds -->
    <stroke
        android:width="1dp"
        android:color="#D5D9DF"/>

    <!-- Optional: if you want a minimum size for the circle background -->
    <!-- <size android:width="64dp" android:height="64dp" /> -->
</shape>
