<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Darker ambient shadow bottom-right -->
    <item
        android:left="4dp"
        android:top="0dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="32dp"/>
            <solid android:color="#33000000"/> <!-- darker translucent shadow -->
        </shape>
    </item>

    <!-- Secondary shadow layer top-left for wrap-around effect -->
    <item
        android:left="0dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="32dp"/>
            <solid android:color="#22000000"/> <!-- softer wrap-around shadow -->
        </shape>
    </item>

    <!-- Top-left highlight -->
    <item
        android:left="6dp"
        android:top="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="32dp"/>
            <solid android:color="#33FFFFFF"/>
        </shape>
    </item>

    <!-- Base surface -->
    <item android:id="@android:id/background"
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#EBECF0"/>
            <corners android:radius="32dp"/>
        </shape>
    </item>

</layer-list>

