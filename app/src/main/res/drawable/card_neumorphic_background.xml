<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:right="8dp"
        android:bottom="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="32dp"/>
            <solid android:color="@color/dark_shadow"/>
        </shape>
    </item>
    <item
        android:left="8dp"
        android:top="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="32dp"/>
            <solid android:color="@color/light_highlight"/>
        </shape>
    </item>
    <item android:id="@android:id/background"
        android:right="3dp"
        android:bottom="3dp"
        android:left="3dp"
        android:top="3dp">
        <shape>
            <gradient android:startColor="@color/elements_background"
                android:centerColor="@color/progress_background"
                android:endColor="@color/elements_background"/>
            <corners android:radius="32dp"/>
        </shape>
    </item>
</layer-list>
