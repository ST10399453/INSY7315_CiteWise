<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:right="8dp"
        android:bottom="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="32dp"/>
            <solid android:color="@color/light_highlight"/>
        </shape>
    </item>

    <item
        android:left="8dp"
        android:top="8dp">
        <shape android:shape="rectangle">
            <corners android:radius="32dp"/>
            <solid android:color="@color/dark_shadow"/>
        </shape>
    </item>

    <item
        android:right="4dp"
        android:bottom="4dp"
        android:left="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="32dp"/>
            <solid android:color="@color/elements_background"/>
        </shape>
    </item>
</layer-list>
