<?xml version="1.0" encoding="utf-8"?>
<!-- Priority chip background with gradient from Figma -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Rounded corners with 12.5dp radius -->
    <corners android:radius="12.5dp" />

    <!-- Gradient fill matching Figma specs -->
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="#75E2E4E9"
        android:centerColor="#75F6F6F6"
        android:endColor="#75E2E4E9" />

</shape>
