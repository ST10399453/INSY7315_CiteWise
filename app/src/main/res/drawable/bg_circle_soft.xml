<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <!-- slightly darker fill on press -->
            <solid android:color="#E9EEF5"/> <!-- tweak to match your theme -->
            <stroke android:width="1dp" android:color="#D9E1EA"/>
            <size android:width="50dp" android:height="50dp"/>
        </shape>
    </item>

    <!-- Default -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#F3F6FA"/>  <!-- soft surface -->
            <stroke android:width="1dp" android:color="#E1E8F0"/>
            <size android:width="50dp" android:height="50dp"/>
        </shape>
    </item>
</selector>
