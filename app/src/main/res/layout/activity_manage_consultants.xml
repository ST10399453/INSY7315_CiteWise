<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background">


    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:padding="8dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/greetingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="@android:color/transparent"
                app:cardBackgroundColor="@android:color/transparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_greeting_card"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:baselineAligned="false"
                        tools:ignore="UseCompoundDrawables">

                        <TextView
                            android:id="@+id/tvManageCnsultant"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/public_sans_bold"
                            android:letterSpacing="0.01"
                            android:text="Consultant Management"
                            android:textColor="@color/text_light"
                            android:textSize="30sp" />

                        <ImageView
                            android:id="@+id/logoIcon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginTop="-4dp"
                            android:src="@drawable/logo"
                            app:tint="@android:color/white"
                            android:contentDescription="@string/app_name" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/subtitleText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="8dp"
                        android:text="Manage consultants and their information."
                        android:textColor="#E0EBECF0"
                        android:textSize="16sp"
                        android:fontFamily="@font/public_sans_medium" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTotalConsultants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="20dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="@android:color/transparent"
                app:cardBackgroundColor="@android:color/transparent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_neumorphic_background"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total Consultants"
                        android:textColor="@color/text_dark"
                        android:textSize="20sp"
                        android:fontFamily="@font/public_sans_medium" />

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_total_consultants"
                        android:contentDescription="@string/app_name" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvConsultantsValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30"
                    android:textColor="@color/gradient_end"
                    android:textSize="22sp"
                    android:fontFamily="@font/public_sans_bold"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardActiveConsultants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="20dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="@android:color/transparent"
                app:cardBackgroundColor="@android:color/transparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_neumorphic_background"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Active"
                            android:textColor="@color/text_dark"
                            android:textSize="20sp"
                            android:fontFamily="@font/public_sans_medium" />

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_active"
                            android:contentDescription="@string/app_name" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvActiveValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24"
                        android:textColor="@color/gradient_end"
                        android:textSize="22sp"
                        android:fontFamily="@font/public_sans_bold"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOnLeaveConsultants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="20dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="@android:color/transparent"
                app:cardBackgroundColor="@android:color/transparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_neumorphic_background"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="On Leave"
                            android:textColor="@color/text_dark"
                            android:textSize="20sp"
                            android:fontFamily="@font/public_sans_medium" />

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_onleave"
                            android:contentDescription="@string/app_name" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvOnLeaveValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6"
                        android:textColor="@color/gradient_end"
                        android:textSize="22sp"
                        android:fontFamily="@font/public_sans_bold"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPendingConsultants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="20dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="@android:color/transparent"
                app:cardBackgroundColor="@android:color/transparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_neumorphic_background"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/labelPendingConsultants"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Pending Consultants"
                        android:textSize="24sp"
                        android:fontFamily="@font/public_sans_medium"
                        android:textColor="@color/text_dark" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

<!--            <TextView-->
<!--                android:id="@+id/labelPendingConsultants"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout_marginTop="16dp"-->
<!--                android:text="Pending Consultants"-->
<!--                android:textSize="16sp"-->
<!--                android:fontFamily="@font/public_sans_bold"-->
<!--                android:textColor="@color/text_dark" />-->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/ui_background">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPendingConsultants"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/emptyPendingConsultants"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="No pending consultant applications"
                    android:textColor="@color/text_faded"
                    android:gravity="center"
                    android:visibility="gone" />
            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPendingAssignments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="20dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="@android:color/transparent"
                app:cardBackgroundColor="@android:color/transparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_neumorphic_background"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/labelPendingAssignments"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Pending Assignments"
                        android:textSize="24sp"
                        android:fontFamily="@font/public_sans_medium"
                        android:textColor="@color/text_dark" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/groupPriority"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        app:singleSelection="true"
                        app:checkedButton="@id/btnFilterAll">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFilterAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:text="All" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFilterUrgent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:text="Urgent" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFilterMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:text="Medium" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFilterLow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:text="Low" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pending Assignments -->
