                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPendingAssignments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:paddingTop="4dp" />

                <TextView
                    android:id="@+id/emptyPendingAssignments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="No unassigned requests"
                    android:textColor="@color/text_faded"
                    android:gravity="center"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Unassigned Consultants -->
            <TextView
                android:id="@+id/labelAssignedConsultants"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Unassigned Consultants"
                android:textSize="16sp"
                android:fontFamily="@font/public_sans_bold"
                android:textColor="@color/text_dark" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_neumorphic_background"
                android:padding="8dp"
                android:orientation="vertical"
                android:layout_marginTop="8dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Search consultants"
                    app:boxBackgroundMode="none"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSearchConsultants"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_dark"
                        android:textColorHint="@color/text_faded"
                        android:imeOptions="actionSearch" />
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAssignedConsultants"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:paddingTop="8dp" />

                <TextView
                    android:id="@+id/emptyUnassignedConsultants"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="All consultants are assigned 🎉"
                    android:textColor="@color/text_faded"
                    android:gravity="center"
                    android:visibility="gone" />
            </LinearLayout>







        </LinearLayout>




