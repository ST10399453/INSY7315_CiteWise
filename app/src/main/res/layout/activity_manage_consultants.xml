<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:padding="8dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Greeting card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/greetingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="@android:color/transparent"
                app:cardBackgroundColor="@android:color/transparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_greeting_card"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:baselineAligned="false"
                        tools:ignore="UseCompoundDrawables">

                        <TextView
                            android:id="@+id/tvManageCnsultant"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/public_sans_bold"
                            android:letterSpacing="0.01"
                            android:text="Consultant Management"
                            android:textColor="@color/text_light"
                            android:textSize="30sp" />

                        <ImageView
                            android:id="@+id/logoIcon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginTop="-4dp"
                            android:src="@drawable/logo"
                            app:tint="@android:color/white"
                            android:contentDescription="@string/app_name" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/subtitleText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="8dp"
                        android:text="Manage consultants and their information."
                        android:textColor="#E0EBECF0"
                        android:textSize="16sp"
                        android:fontFamily="@font/public_sans_medium" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- KPI: Total consultants -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTotalConsultants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="20dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="@android:color/transparent"
                app:cardBackgroundColor="@android:color/transparent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_neumorphic_background"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Total Consultants"
                            android:textColor="@color/text_dark"
                            android:textSize="18sp"
                            android:fontFamily="@font/public_sans_medium" />

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_total_consultants"
                            android:contentDescription="@string/app_name" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvConsultantsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30"
                        android:textColor="@color/gradient_end"
                        android:textSize="24sp"
                        android:fontFamily="@font/public_sans_bold"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- KPI: Active consultants -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardActiveConsultants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="20dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="@android:color/transparent"
                app:cardBackgroundColor="@android:color/transparent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_neumorphic_background"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Active"
                            android:textColor="@color/text_dark"
                            android:textSize="18sp"
                            android:fontFamily="@font/public_sans_medium" />

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_total_consultants"
                            android:contentDescription="@string/app_name" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvActiveValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24"
                        android:textColor="@color/gradient_end"
                        android:textSize="24sp"
                        android:fontFamily="@font/public_sans_bold"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- KPI: On leave -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOnLeaveConsultants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="20dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="@android:color/transparent"
                app:cardBackgroundColor="@android:color/transparent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_neumorphic_background"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="On Leave"
                            android:textColor="@color/text_dark"
                            android:textSize="18sp"
                            android:fontFamily="@font/public_sans_medium" />

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_total_consultants"
                            android:contentDescription="@string/app_name" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvOnLeaveValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6"
                        android:textColor="@color/gradient_end"
                        android:textSize="24sp"
                        android:fontFamily="@font/public_sans_bold"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- PENDING CONSULTANTS -->
            <TextView
                android:id="@+id/labelPendingConsultants"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Pending Consultant Approvals"
                android:textSize="18sp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/gradient_end"
                android:layout_marginBottom="8dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPendingConsultants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

            <TextView
                android:id="@+id/emptyPendingConsultants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No pending consultants."
                android:textAlignment="center"
                android:textColor="@color/text_faded"
                android:padding="24dp"
                android:visibility="gone"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="@color/dark_shadow" />

            <!-- UNASSIGNED REVIEWS / ASSIGNMENTS -->
            <TextView
                android:id="@+id/labelAssignments"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unassigned Service Reviews"
                android:textSize="18sp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/gradient_end"
                android:layout_marginBottom="8dp"/>

            <!-- Priority filter (MATCHES ManageConsultants) -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/groupPriority"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/toggle_group_track"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterAll"
                    style="@style/Widget.CiteWise.ProfileToggle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="All"
                    android:checkable="true"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterUrgent"
                    style="@style/Widget.CiteWise.ProfileToggle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="High"
                    android:checkable="true"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterMedium"
                    style="@style/Widget.CiteWise.ProfileToggle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Medium"
                    android:checkable="true"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterLow"
                    style="@style/Widget.CiteWise.ProfileToggle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Low"
                    android:checkable="true"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPendingAssignments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

            <TextView
                android:id="@+id/emptyPendingAssignments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="All caught up — no unassigned reviews."
                android:textAlignment="center"
                android:textColor="@color/text_faded"
                android:padding="24dp"
                android:visibility="gone"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="@color/dark_shadow" />

            <!-- CONSULTANTS LIST HEADER -->
            <TextView
                android:id="@+id/labelConsultants"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Consultants"
                android:textSize="18sp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/gradient_end"
                android:layout_marginBottom="8dp"/>

            <!-- Search (hidden for now) -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:hint="Search consultants"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearchConsultants"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Unassigned / Assigned toggle (MATCHES ManageConsultants) -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/groupConsultants"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/toggle_group_track"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShowUnassigned"
                    style="@style/Widget.CiteWise.ProfileToggle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Unassigned"
                    android:checkable="true"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShowAssigned"
                    style="@style/Widget.CiteWise.ProfileToggle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Assigned"
                    android:checkable="true"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Shared RecyclerView; adapter swapped by toggle -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAssignedConsultants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="8dp"/>

            <!-- Empty states for each sub-tab -->
            <TextView
                android:id="@+id/emptyUnassignedConsultants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No unassigned consultants."
                android:textAlignment="center"
                android:textColor="@color/text_faded"
                android:padding="24dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/emptyAssignedConsultants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No assigned consultants yet."
                android:textAlignment="center"
                android:textColor="@color/text_faded"
                android:padding="24dp"
                android:visibility="gone"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
