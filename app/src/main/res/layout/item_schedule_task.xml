<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="10dp"
    android:paddingHorizontal="8dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/rounded_card_background"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <View
        android:id="@+id/statusDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/ic_dot_green"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/scheduleServiceType"
        android:layout_marginTop="6dp"/>

    <TextView
        android:id="@+id/scheduleServiceType"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/text_dark"
        android:textSize="14sp"
        android:fontFamily="@font/poppins_medium"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/statusDot"
        app:layout_constraintEnd_toStartOf="@id/scheduleUrgencyTag"
        tools:text="Data Analysis Support" />

    <TextView
        android:id="@+id/scheduleDocumentName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/text_faded"
        android:textSize="12sp"
        android:fontFamily="@font/poppins"
        android:layout_marginTop="2dp"
        android:layout_marginStart="12dp"
        app:layout_constraintTop_toBottomOf="@id/scheduleServiceType"
        app:layout_constraintStart_toEndOf="@id/statusDot"
        app:layout_constraintEnd_toStartOf="@id/scheduleUrgencyTag"
        tools:text="Qualitative Study" />

    <TextView
        android:id="@+id/scheduleUrgencyTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/priority_High"
        android:textSize="12sp"
        android:fontFamily="@font/poppins_sembold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="Urgent" />

</androidx.constraintlayout.widget.ConstraintLayout>