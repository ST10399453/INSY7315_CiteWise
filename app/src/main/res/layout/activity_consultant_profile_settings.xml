<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="8dp"
    android:background="@color/ui_background"
    tools:context=".ConsultantProfileSettingsActivity">

    <LinearLayout
        android:id="@+id/rootColumn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:id="@+id/tvProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="Profile"
            android:textColor="@color/gradient_end"
            android:textSize="36sp"
            android:fontFamily="@font/poppins_extra_bold"
            android:textStyle="bold" />

        <!-- Pill Toggle (same pattern as Manage Consultants) -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleSettings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/toggle_group_track"
            android:clipToPadding="false"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOverview"
                style="@style/Widget.CiteWise.ProfileToggle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Overview"
                android:checkable="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProfileSettings"
                style="@style/Widget.CiteWise.ProfileToggle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Settings"
                android:checkable="true" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- ===================== OVERVIEW ===================== -->
        <LinearLayout
            android:id="@+id/sectionOverview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            tools:visibility="visible"
            android:layout_marginTop="12dp">

            <!-- Card -->
            <LinearLayout
                android:id="@+id/overviewCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/rounded_card_background"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header row -->
                <LinearLayout
                    android:id="@+id/rowHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_user_avatar"
                        android:background="@drawable/circle_bg"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/profile_picture" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvOverviewName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/loading_name_placeholder"
                            android:textColor="@color/text_dark"
                            android:textSize="18sp"
                            android:fontFamily="@font/poppins_sembold" />

                        <TextView
                            android:id="@+id/tvOverviewEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/loading_email_placeholder"
                            android:textColor="@color/text_faded"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins" />

                        <TextView
                            android:id="@+id/tvExpertise"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="—"
                            android:textColor="@color/text_faded"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_medium" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Stats -->
                <LinearLayout
                    android:id="@+id/rowStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:weightSum="4">

                    <LinearLayout style="@style/StatColumn">
                        <TextView android:id="@+id/tvStatRequests" style="@style/StatValue" android:text="0" />
                        <TextView style="@style/StatLabel" android:text="Requests" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatColumn">
                        <TextView android:id="@+id/tvStatCompleted" style="@style/StatValue" android:text="0" />
                        <TextView style="@style/StatLabel" android:text="Completed" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatColumn">
                        <TextView android:id="@+id/tvStatTurnaround" style="@style/StatValue" android:text="0" />
                        <TextView style="@style/StatLabel" android:text="Avg Days" />
                    </LinearLayout>

                    <LinearLayout style="@style/StatColumn">
                        <TextView android:id="@+id/tvStatRating" style="@style/StatValue" android:text="0" />
                        <TextView style="@style/StatLabel" android:text="Rating" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/dark_shadow" />

                <!-- Overview rows -->
                <include
                    android:id="@+id/rowOverviewAcademic"
                    layout="@layout/item_row_value" />

                <include
                    android:id="@+id/rowOverviewInstitution"
                    layout="@layout/item_row_value" />

                <include
                    android:id="@+id/rowOverviewRole"
                    layout="@layout/item_row_value" />

                <include
                    android:id="@+id/rowOverviewLanguage"
                    layout="@layout/item_row_value" />
            </LinearLayout>

            <!-- History -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Service Request History"
                android:textColor="@color/text_dark"
                android:textSize="20sp"
                android:fontFamily="@font/poppins_sembold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvServiceHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_consultant_history" />

            <!-- Turnaround chart -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Turnaround Time"
                style="@style/SettingsSectionHeader" />

            <WebView
                android:id="@+id/turnaroundTimeChartWebView"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@drawable/rounded_card_background" />

            <!-- Rating -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Average Student Rating"
                style="@style/SettingsSectionHeader" />

            <TextView
                android:id="@+id/tvRatingStars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="6dp"
                android:text="★★★★★"
                android:textColor="@color/gradient_end"
                android:textSize="18sp"
                android:fontFamily="@font/poppins_sembold" />

            <include layout="@layout/include_rating_display" />
        </LinearLayout>

        <!-- ===================== SETTINGS ===================== -->
        <LinearLayout
            android:id="@+id/sectionSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Account"
                style="@style/SettingsSectionHeader"
                android:layout_marginStart="19dp" />

            <include
                android:id="@+id/rowEditProfile"
                layout="@layout/item_row_nav" />

            <include
                android:id="@+id/rowChangePassword"
                layout="@layout/item_row_nav" />

            <include
                android:id="@+id/rowUploadCV"
                layout="@layout/item_row_nav" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notifications"
                style="@style/SettingsSectionHeader"
                android:layout_marginStart="19dp" />

            <include
                android:id="@+id/rowPushNotifications"
                layout="@layout/item_row_switch" />

            <include
                android:id="@+id/rowAppNotifications"
                layout="@layout/item_row_switch" />

            <include
                android:id="@+id/rowEmailNotifications"
                layout="@layout/item_row_switch" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Language"
                style="@style/SettingsSectionHeader"
                android:layout_marginStart="19dp" />

            <include
                android:id="@+id/rowLanguage"
                layout="@layout/item_row_value" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/btn_login"
                android:fontFamily="@font/poppins_bold"
                android:text="LOG OUT"
                android:textAllCaps="true"
                android:textColor="@color/text_dark"
                app:backgroundTint="@null" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
