<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    tools:context=".LoginActivity">

    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="0dp"
        android:layout_height="656dp"
        android:layout_margin="24dp"
        android:background="@drawable/card_neumorphic_background"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Logo -->
        <ImageView
            android:id="@+id/logo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="16dp"
            android:layout_marginTop="128dp"
            android:contentDescription="Logo"
            android:src="@drawable/logo" />

        <TextView
            android:id="@+id/tvLoginTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:fontFamily="@font/poppins_bold"
            android:text="Login"
            android:textColor="@color/gradient_end"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Email -->
        <TextView
            android:id="@+id/tvEmailLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="24dp"
            android:fontFamily="@font/poppins"
            android:labelFor="@id/etEmail"
            android:text="Email Address"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/text_field"
            android:fontFamily="@font/poppins"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textColor="@color/text_faded"
            android:textSize="14sp"
            tools:text="ethan@example.com" />

        <!-- Password -->
        <TextView
            android:id="@+id/tvPasswordLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="24dp"
            android:fontFamily="@font/poppins"
            android:labelFor="@id/etPassword"
            android:text="Password"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/text_field"
            android:fontFamily="@font/poppins"
            android:inputType="textPassword"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textColor="@color/text_faded"
            android:textSize="14sp"/>

        <!-- Remember / Forgot -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginHorizontal="24dp">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbRemember"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:paddingLeft="8dp"
                android:text="Remember Me"
                android:textColor="@color/text_dark"
                android:textSize="13sp"
                app:buttonTint="@color/checkbox_tint"/>

            <TextView
                android:id="@+id/tvForgot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/poppins_sembold"
                android:text="Forgot Password"
                android:textColor="@color/gradient_end"
                android:textSize="13sp"
                android:padding="16dp"
                android:layout_marginStart="2dp"/>
        </LinearLayout>

        <!-- Login button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_margin="8dp"
            android:background="@drawable/btn_register"
            android:fontFamily="@font/poppins_bold"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="LOGIN"
            android:textAllCaps="true"
            android:textColor="@color/text_light"
            android:textSize="16sp"
            app:backgroundTint="@null"/>

        <!-- Continue with Google (single button) -->
        <Button
            android:id="@+id/btnGoogleLogin"
            android:layout_width="320dp"
            android:layout_height="56dp"
            app:icon="@drawable/ic_google"
            app:iconTint="@null"
            android:text="@string/continue_with_google"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:fontFamily="@font/poppins_bold"
            android:elevation="8dp"
            android:textSize="15sp"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp"
            android:background="@drawable/btn_login"
            android:layout_marginTop="16dp"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            app:backgroundTint="@null"/>

        <!-- Footer -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_gravity="center_horizontal">

            <TextView
                android:id="@+id/tvNewUserLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:text="New User? "
                android:textColor="@color/text_dark"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvGoSignUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_sembold"
                android:text=" Register"
                android:textColor="@color/gradient_end"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
