<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_background"
    tools:context=".LoginActivity">


    <!-- Scrollable content -->
    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="0dp"
        android:layout_height="680dp"
        android:layout_margin="24dp"
        android:background="@drawable/card_neumorphic_background"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:cardCornerRadius="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="16dp"
            android:layout_marginTop="102dp"
            android:contentDescription="Logo"
            android:src="@drawable/logo"/>

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvLoginTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/poppins_bold"
            android:text="Login"
            android:textColor="@color/text_dark"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Email label -->
        <TextView
            android:id="@+id/tvEmailLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:layout_marginHorizontal="24dp"
            android:fontFamily="@font/poppins"
            android:labelFor="@id/etEmail"
            android:text="Email Address"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />
        <!-- Email input -->


            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="336dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_margin="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/btn_login"
                android:fontFamily="@font/poppins"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="20dp"
                android:textColor="@color/text_faded"
                android:textSize="14sp"
                tools:text="ethan@example.com" />


        <!-- Password label -->
        <TextView
            android:id="@+id/tvPasswordLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:layout_marginHorizontal="24dp"
            android:fontFamily="@font/poppins"
            android:labelFor="@id/etPassword"
            android:text="Password"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />

        <!-- Password input -->


            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="336dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_margin="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/btn_login"
                android:fontFamily="@font/poppins_bold"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:paddingHorizontal="20dp"
                android:inputType="textEmailAddress"
                android:textSize="14sp"
                android:textColor="@color/text_dark" />

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginHorizontal="8dp">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cbRemember"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins"
                android:padding="8dp"
                android:text="Remember Me"
                android:textColor="@color/text_dark"
                android:textColorLink="@color/text_dark"
                android:textSize="12sp"
                android:textStyle="bold" />



            <!-- Keep id = tvForgot for Kotlin -->
            <TextView
                android:id="@+id/tvForgot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/poppins"
                android:text="Forgot Password"
                android:textColor="@color/gradient_middle"
                android:textSize="14sp"
                android:padding="16dp"
                android:layout_marginStart="8dp"/>
    </LinearLayout>

        <!-- Login button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="320"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_margin="8dp"
            android:background="@drawable/btn_register"
            android:fontFamily="@font/poppins_bold"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="LOGIN"
            android:textAllCaps="true"
            android:textColor="@color/text_light"
            app:backgroundTint="@null"/>

        <!-- "Or continue with" -->
        <TextView
            android:id="@+id/tvOrContinue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/poppins"
            android:text="or continue with"
            android:textColor="@color/text_dark"
            android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="90dp"
        android:layout_marginBottom="10dp">


        <!-- Social logins -->


            <ImageButton
                android:id="@+id/btnGoogle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="8dp"
                android:layout_marginLeft="24dp"
                android:background="@drawable/circle_background"
                android:contentDescription="google"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_google" />

            <ImageView
                android:id="@+id/btnFacebook"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="6dp"
                android:background="@drawable/circle_background"
                android:contentDescription="Facebook"
                android:padding="10dp"
                android:src="@drawable/ic_facebook" />

            <ImageView
                android:id="@+id/btnApple"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="6dp"
                android:background="@drawable/circle_background"
                android:contentDescription="Apple"
                android:padding="10dp"
                android:src="@drawable/ic_apple" />

    </LinearLayout>
        <!-- Footer -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="96dp">
            <TextView
                android:id="@+id/tvNewUserLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:text="New User? "
                android:textColor="@color/text_dark"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvGoSignUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_sembold"
                android:text=" Register"
                android:textColor="@color/gradient_middle"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
