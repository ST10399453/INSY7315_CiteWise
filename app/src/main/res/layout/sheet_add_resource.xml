<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@color/ui_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="New Resource"
            android:textColor="@color/gradient_end"
            android:fontFamily="@font/public_sans_medium"
            android:textStyle="bold"
            android:textSize="24sp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category"
            android:textColor="@color/text_dark"
            android:fontFamily="@font/poppins_medium"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCategory"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:hintEnabled="false"
            app:endIconDrawable="@drawable/ic_down_arrow"
            app:endIconTint="@null"
            android:textSize="14sp"
            app:endIconMode="dropdown_menu"
            android:layout_marginBottom="16dp">

            <AutoCompleteTextView
                android:id="@+id/actCategory"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Category"
                android:textSize="14sp"
                android:background="@drawable/text_field"
                android:popupBackground="@drawable/bg_spinner_popup_white"
                android:inputType="none"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@android:color/black"
                android:textColorHint="@android:color/darker_gray"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Faculty"
        android:textColor="@color/text_dark"
        android:fontFamily="@font/poppins_medium"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFaculty"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:hintEnabled="false"
            app:endIconDrawable="@drawable/ic_down_arrow"
            app:endIconTint="@null"
            android:textSize="14sp"
            app:endIconMode="dropdown_menu"
            android:layout_marginBottom="16dp">

            <AutoCompleteTextView
                android:id="@+id/actFaculty"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Faculty"
                android:textSize="14sp"
                android:background="@drawable/text_field"
                android:popupBackground="@drawable/bg_spinner_popup_white"
                android:inputType="none"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@android:color/black"
                android:textColorHint="@android:color/darker_gray"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Title"
            android:textColor="@color/text_dark"
            android:fontFamily="@font/poppins_medium"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/tilTitle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/text_field"
            android:fontFamily="@font/poppins"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_dark"
            android:textSize="14sp"
            android:layout_marginBottom="18dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upload Resource File"
            android:textColor="@color/text_dark"
            android:fontFamily="@font/poppins_medium"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/cardPicker"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_dashed_border"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/iconUpload"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_file_upload"
                android:layout_marginBottom="8dp"
                app:tint="@color/gradient_end" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="32dp"
                    android:layout_height="1.5dp"
                    android:background="@color/gradient_end"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/txtSelectFile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select a file"
                    android:textColor="#757575"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_medium" />

                <View
                    android:layout_width="32dp"
                    android:layout_height="1.5dp"
                    android:background="@color/gradient_end"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@null"
            android:textColor="@color/text_dark"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_medium"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resource Description"
            android:textColor="@color/text_dark"
            android:fontFamily="@font/poppins_medium"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="125dp"
            android:background="@drawable/text_field"
            android:hint="@string/enter_additional_information"
            android:fontFamily="@font/public_sans_medium"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:overScrollMode="always"
            android:textColor="@color/text_dark"
            android:textColorHint="#757575"
            android:textSize="15sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpload"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="UPLOAD"
                android:textAllCaps="false"
                android:textColor="@color/text_light"
                android:background="@drawable/btn_register"
                app:backgroundTint="@null"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="20dp"/>

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:visibility="gone"/>
        </FrameLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
