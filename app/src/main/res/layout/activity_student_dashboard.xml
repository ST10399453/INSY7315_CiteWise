            <!-- Service Quote -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_margin="24dp"
                app:cardUseCompatPadding="true"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/rounded_card_background"
                    android:visibility="gone">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/tvQuoteTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Service Quote"
                            android:textColor="@color/gradient_end"
                            android:textSize="20sp"
                            android:fontFamily="@font/poppins_sembold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/chipTotal"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <TextView
                            android:id="@+id/chipTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="Total: R6500"
                            android:textColor="@color/gradient_middle"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_bold"
                            android:background="@drawable/btn_login"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBaseline_toBaselineOf="@id/tvQuoteTitle"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:id="@+id/tvQuoteSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Business Plan Draft"
                        android:textColor="@color/text_dark"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins_medium"
                        android:layout_marginBottom="4dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Submitted"
                            android:textColor="@color/text_faded"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins"/>

                        <TextView
                            android:id="@+id/tvDeadline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Deadline: 26/11/2025"
                            android:textColor="@color/text_faded"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins"/>
                    </LinearLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAccept"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="6dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="12dp"
                            android:text="Accept"
                            android:textAllCaps="false"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="10sp"
                            app:autoSizeMaxTextSize="12sp"
                            app:autoSizeStepGranularity="1sp"
                            app:iconPadding="0dp"
                            android:textColor="@color/text_light"
                            android:background="@drawable/btn_register"
                            app:backgroundTint="@null"
                            app:cornerRadius="24dp"
                            android:fontFamily="@font/poppins_bold"
                            android:stateListAnimator="@null"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/btnDownloadPDF"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintHorizontal_weight="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDownloadPDF"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="6dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="12dp"
                            android:text="Download"
                            android:textAllCaps="false"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="10sp"
                            app:autoSizeMaxTextSize="12sp"
                            app:autoSizeStepGranularity="1sp"
                            app:iconPadding="0dp"
                            android:textColor="@color/text_light"
                            android:background="@drawable/btn_register"
                            app:backgroundTint="@null"
                            app:cornerRadius="24dp"
                            android:fontFamily="@font/poppins_bold"
                            android:stateListAnimator="@null"
                            app:layout_constraintStart_toEndOf="@id/btnAccept"
                            app:layout_constraintEnd_toStartOf="@id/btnRequestReview"
                            app:layout_constraintTop_toTopOf="@id/btnAccept"
                            app:layout_constraintHorizontal_weight="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRequestReview"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="6dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="12dp"
                            android:text="Review"
                            android:textAllCaps="false"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="10sp"
                            app:autoSizeMaxTextSize="12sp"
                            app:autoSizeStepGranularity="1sp"
                            app:iconPadding="0dp"
                            android:textColor="@color/text_light"
                            android:background="@drawable/btn_register"
                            app:backgroundTint="@null"
                            app:cornerRadius="24dp"
                            android:fontFamily="@font/poppins_bold"
                            android:stateListAnimator="@null"
                            app:layout_constraintStart_toEndOf="@id/btnDownloadPDF"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@id/btnAccept"
                            app:layout_constraintHorizontal_weight="1" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
