<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/ui_background">

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="32dp"
                    android:layout_height="26dp"
                    android:src="@drawable/hamburger"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Menu"
                    android:visibility="gone"/>


            <!--  Greeting Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/greetingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="@android:color/transparent"
                app:cardBackgroundColor="@android:color/transparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_greeting_card"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:baselineAligned="false"
                        tools:ignore="UseCompoundDrawables">

                        <TextView
                            android:id="@+id/tvGreeting"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/public_sans_bold"
                            android:letterSpacing="0.01"
                            android:text="@string/user_dashboard"
                            android:textColor="@color/text_light"
                            android:textSize="30sp" />

                        <ImageView
                            android:id="@+id/logoIcon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginTop="-4dp"
                            android:src="@drawable/logo"
                            app:tint="@android:color/white"
                            android:contentDescription="@string/app_name" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/subtitleText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/student_opening_msg"
                        android:textColor="#E0EBECF0"
                        android:textSize="16sp"
                        android:fontFamily="@font/public_sans_medium" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvMyRequests"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_requests"
                android:textColor="@color/gradient_end"
                android:textSize="24sp"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/poppins_bold"
                android:layout_marginTop="8dp"/>

            <!-- Service Request Card-->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/serviceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:cardCornerRadius="20dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="@android:color/transparent"
                app:cardBackgroundColor="@android:color/transparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/rounded_card_background">

                    <!-- Inner container adds inner spacing, not the card itself -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <!-- RecyclerView -->
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rvRequests"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:nestedScrollingEnabled="false"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp" />

                            <TextView
                                android:id="@+id/tvEmptyRequests"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="No service requests"
                                android:textColor="@android:color/darker_gray"
                                android:textSize="16sp"
                                android:fontFamily="@font/poppins_regular"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="12dp"
                                android:visibility="gone"/>
                        </FrameLayout>



                    <TextView
                        android:id="@+id/tvViewAllTasks"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View all active tasks >"
                        android:textColor="@color/gradient_end"
                        android:fontFamily="@font/poppins_sembold"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"/>
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRequestService"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="4dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/btn_register"
                android:fontFamily="@font/poppins_bold"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="Request a Service"
                android:textAllCaps="true"
                android:textColor="@color/text_light"
                android:textSize="16sp"
                app:backgroundTint="@null"/>

            <!-- Notifications-->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/notifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:cardCornerRadius="20dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="@android:color/transparent"
                app:cardBackgroundColor="@android:color/transparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/rounded_card_background"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        tools:ignore="UselessParent">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tvNotifications"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/notifications"
                            android:paddingStart="12dp"
                            android:paddingTop="8dp"
                            android:textColor="#000"
                            android:textSize="22sp"
                            android:fontFamily="@font/public_sans_medium"
                            android:layout_toStartOf="@id/icNotification"
                            tools:ignore="RtlSymmetry" />

                        <ImageView
                            android:id="@+id/icNotification"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_alignTop="@id/tvNotifications"
                            android:layout_alignParentEnd="true"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@string/app_name"
                            android:src="@drawable/ic_notification" />
                    </RelativeLayout>


                <!-- Notification Items -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="24dp">

                    <!-- Missing-->
