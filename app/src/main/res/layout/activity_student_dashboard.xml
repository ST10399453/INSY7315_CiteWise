<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_background">

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:padding="8dp"
        android:paddingBottom="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:src="@drawable/logo"
                    android:contentDescription="App Logo" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- give it an id -->
                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="32dp"
                    android:layout_height="26dp"
                    android:src="@drawable/hamburger"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Menu" />
            </LinearLayout>

            <!-- Greeting (start as 'Hi') -->
            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="22dp"
                android:text="Hi, "
                android:textColor="@color/gradient_end"
                android:textSize="36sp"
                android:fontFamily="@font/poppins_extra_bold"
                android:textStyle="bold"/>

            <!-- Service Request Progress -->

            <!-- Request Service CTA -->

            <LinearLayout
                android:layout_width="360dp"
                android:layout_height="160dp"
                android:layout_gravity="center_horizontal"
                android:layout_margin="24dp"
                android:background="@drawable/card_neumorphic_background"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/poppins_sembold"
                    android:paddingLeft="16dp"
                    android:paddingTop="16dp"
                    android:text="Service Request Progress"
                    android:textColor="@color/gradient_end"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/poppins_medium"
                    android:paddingLeft="16dp"
                    android:text="Business Plan Draft"
                    android:textColor="@color/text_dark"
                    android:textSize="16sp" />

                <ProgressBar
                    android:id="@+id/progressService"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="328dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="8dp"
                    android:elevation="4dp"
                    android:max="100"
                    android:progress="75"
                    android:progressDrawable="@drawable/custom_progress_bar" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:paddingLeft="16dp"
                    android:text="Submitted  •  Deadline: 25.08.2025"
                    android:textColor="@color/text_faded"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRequestService"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="24dp"
                android:background="@drawable/btn_login"
                android:fontFamily="@font/poppins_sembold"
                android:text="Request a Service"
                android:textColor="@color/gradient_end"
                android:textSize="16sp"
                android:textAllCaps="true"
                app:cornerRadius="50dp"
                app:backgroundTint="@null"/>

            <!-- Notifications -->
            <LinearLayout
                android:layout_width="360dp"
                android:layout_height="370dp"
                android:layout_margin="24dp"
                android:background="@drawable/card_neumorphic_background"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNotifications"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:paddingTop="24dp"
                    android:paddingLeft="24dp"
                    android:fontFamily="@font/poppins_sembold"
                    android:text="Notifications"
                    android:textColor="@color/gradient_end"
                    android:textSize="24sp" />

                <!-- Missing Documents -->
                <LinearLayout
                    android:id="@+id/btnMissingDocuments"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/button_gradient_blue"
                    android:paddingTop="10dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:layout_gravity="center_horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/ripple_white_rounded"
                    android:contentDescription="Missing Documents"
                    android:orientation="horizontal">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Missing Documents"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins_medium"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="3.5"/>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/warning"
                        android:contentDescription="@null"
                        app:tint="@android:color/white"
                        android:padding="1dp"/>

                </LinearLayout>

                <!-- Feedback -->
                <LinearLayout
                    android:id="@+id/btnFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/button_gradient_blue"
                    android:paddingTop="10dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:layout_gravity="center_horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/ripple_white_rounded"
                    android:contentDescription="Feedback"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Feedback"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins_medium"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="3.5"/>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/edit"
                        android:contentDescription="@null"
                        app:tint="@android:color/white"
                        android:padding="2dp"/>

                </LinearLayout>

                <!-- New Messages -->
                <LinearLayout
                    android:id="@+id/btnNewMessages"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/button_gradient_blue"
                    android:paddingTop="10dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:layout_gravity="center_horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/ripple_white_rounded"
                    android:contentDescription="New Messages"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="New Messages"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins_medium"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="3.5"/>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/comment"
                        android:contentDescription="@null"
                        app:tint="@android:color/white"
                        android:padding="1dp"/>
                </LinearLayout>

                <!-- Rate your consultant -->
                <LinearLayout
                    android:id="@+id/btnRateConsultant"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/button_gradient_blue"
                    android:paddingTop="10dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:layout_gravity="center_horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/ripple_white_rounded"
                    android:contentDescription="Rate your Consultant"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rate your consultant"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins_medium"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="3.5"/>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/rating"
                        android:contentDescription="@null"
                        app:tint="@android:color/white" />
                </LinearLayout>

                <!-- Status update -->
                <LinearLayout
                    android:id="@+id/btnStatusUpdate"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/button_gradient_blue"
                    android:paddingTop="10dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:layout_gravity="center_horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/ripple_white_rounded"
                    android:contentDescription="Status Update"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Status update"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins_medium"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="3.5"/>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/recycle"
                        android:contentDescription="@null"
                        app:tint="@android:color/white"
                        android:padding="2dp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- AI Assistant -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Assistant"
                android:textColor="@color/gradient_end"
                android:textSize="24sp"
                android:fontFamily="@font/poppins_bold"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="156dp"
                android:layout_height="156dp"
                android:padding="16dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/card_neumorphic_background"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/ivAssistant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:background="@color/elements_background"
                    app:srcCompat="@drawable/ai_logo"
                    android:scaleType="centerInside"
                    android:adjustViewBounds="true"
                    app:tint="@null"
                    android:contentDescription="AI Assistant" />
            </LinearLayout>

            <!-- Service Quote -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_margin="24dp"
                android:background="@drawable/card_neumorphic_background"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp"
                    android:paddingLeft="16dp"
                    android:fontFamily="@font/poppins_sembold"
                    android:text="Service Quote"
                    android:textColor="@color/gradient_end"
                    android:textSize="24sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:layout_marginRight="16dp"
                            android:paddingTop="8dp"
                            android:paddingLeft="16dp"
                            android:fontFamily="@font/poppins_medium"
                            android:text="Business Plan Draft"
                            android:textColor="@color/text_dark"
                            android:textSize="16sp"/>

                        <LinearLayout
                            android:layout_width="148dp"
                            android:layout_height="40dp"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/btn_login"
                            android:layout_gravity="center_horizontal"
                            android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAlignment="center"
                            android:layout_gravity="center_horizontal"
                            android:paddingLeft="10dp"
                            android:paddingTop="4dp"
                            android:text="Total: R6500"
                            android:fontFamily="@font/poppins_bold"
                            android:textColor="@color/gradient_middle"
                            android:textSize="20sp" />
                        </LinearLayout>
                    </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:paddingLeft="208dp"
                    android:fontFamily="@font/poppins"
                    android:text="Deadline: 26/11/2025"
                    android:textColor="@color/text_faded"
                    android:textSize="12sp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAccept"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="8dp"
                        android:background="@drawable/btn_register"
                        android:fontFamily="@font/poppins_bold"
                        android:text="Accept"
                        android:textColor="@color/text_light"
                        android:textSize="12sp"
                        android:textAllCaps="true"
                        app:backgroundTint="@null"
                        app:cornerRadius="50dp"
                        android:stateListAnimator="@null"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDownloadPDF"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="8dp"
                        android:background="@drawable/btn_register"
                        android:fontFamily="@font/poppins_bold"
                        android:text="Download"
                        android:textColor="@color/text_light"
                        android:textSize="12sp"
                        android:textAllCaps="true"
                        app:backgroundTint="@null"
                        app:cornerRadius="50dp"
                        android:stateListAnimator="@null"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRequestReview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/btn_register"
                        android:fontFamily="@font/poppins_bold"
                        android:text="Review"
                        android:textColor="@color/text_light"
                        android:textSize="12sp"
                        android:textAllCaps="true"
                        app:backgroundTint="@null"
                        app:cornerRadius="50dp"
                        android:stateListAnimator="@null"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom navigation anchored to bottom -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="360dp"
        android:layout_height="64dp"
        android:background="@drawable/btn_login"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
