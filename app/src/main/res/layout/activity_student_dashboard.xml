                    <!-- Feedback -->
                    <LinearLayout
                        android:id="@+id/btnFeedback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingVertical="12dp"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_feedback"
                            android:contentDescription="@string/app_name" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/public_sans_medium"
                            android:text="@string/feedback_recivied"
                            android:textColor="@color/gradient_end"
                            android:textSize="16sp" />

                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="@string/open_notification"
                            app:tint="@color/gradient_end" />
                    </LinearLayout>

                    <!-- Msg -->
                    <LinearLayout
                        android:id="@+id/btnNewMessages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingVertical="12dp"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_new_messages"
                            android:contentDescription="@string/app_name" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/public_sans_medium"
                            android:text="@string/_1_new_message"
                            android:textColor="@color/gradient_end"
                            android:textSize="16sp" />

                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:src="@drawable/ic_chevron_right"
                            android:contentDescription="@string/open_notification"
                            app:tint="@color/gradient_end" />
                    </LinearLayout>

                    <!--  Consult-->
                    <LinearLayout
                        android:id="@+id/btnRateConsultant"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingVertical="12dp"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_rate_consultant"
                            android:contentDescription="@string/app_name" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/public_sans_medium"
                            android:text="@string/rate_your_consultant"
                            android:textColor="@color/gradient_end"
                            android:textSize="16sp" />

                        <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:src="@drawable/ic_chevron_right"
