<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_background">

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:padding="8dp"
        android:paddingBottom="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:src="@drawable/logo"
                    android:contentDescription="App Logo" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="32dp"
                    android:layout_height="26dp"
                    android:src="@drawable/hamburger"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Menu" />
            </LinearLayout>

            <!-- Greeting -->
            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="22dp"
                android:text="Hi"
                android:textColor="@color/gradient_end"
                android:textSize="36sp"
                android:fontFamily="@font/poppins_extra_bold"
                android:textStyle="bold"/>

            <!-- Service Request Progress card -->
            <LinearLayout
                android:layout_width="360dp"
                android:layout_height="160dp"
                android:layout_gravity="center_horizontal"
                android:layout_margin="24dp"
                android:background="@drawable/card_neumorphic_background"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/poppins_sembold"
                    android:paddingLeft="16dp"
                    android:paddingTop="16dp"
                    android:text="Service Request Progress"
                    android:textColor="@color/gradient_end"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/poppins_medium"
                    android:paddingLeft="16dp"
                    android:text="Business Plan Draft"
                    android:textColor="@color/text_dark"
                    android:textSize="16sp" />

                <ProgressBar
                    android:id="@+id/progressService"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="328dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="8dp"
                    android:elevation="4dp"
                    android:max="100"
                    android:progress="75"
                    android:progressDrawable="@drawable/custom_progress_bar" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:paddingLeft="16dp"
                    android:text="Submitted  •  Deadline: 25.08.2025"
                    android:textColor="@color/text_faded"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- CTA -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRequestService"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginHorizontal="24dp"
                android:background="@drawable/btn_login"
                android:fontFamily="@font/poppins_sembold"
                android:text="Request a Service"
                android:textColor="@color/gradient_end"
                android:textSize="16sp"
                android:textAllCaps="true"
                app:cornerRadius="50dp"
                app:backgroundTint="@null"/>

            <!-- Notifications card -->
            <LinearLayout
                android:layout_width="360dp"
                android:layout_height="370dp"
                android:layout_margin="24dp"
                android:background="@drawable/card_neumorphic_background"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNotifications"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:paddingTop="24dp"
                    android:paddingLeft="24dp"
                    android:fontFamily="@font/poppins_sembold"
                    android:text="Notifications"
                    android:textColor="@color/gradient_end"
                    android:textSize="24sp" />

                <!-- Buttons -->
                <LinearLayout
                    android:id="@+id/btnMissingDocuments"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/button_gradient_blue"
                    android:paddingTop="10dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:layout_gravity="center_horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/ripple_white_rounded"
                    android:contentDescription="Missing Documents"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Missing Documents"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins_medium"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="3.5"/>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/warning"
                        android:contentDescription="@null"
                        app:tint="@android:color/white"
                        android:padding="1dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/button_gradient_blue"
                    android:paddingTop="10dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:layout_gravity="center_horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/ripple_white_rounded"
                    android:contentDescription="Feedback"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Feedback"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins_medium"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="3.5"/>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/edit"
                        android:contentDescription="@null"
                        app:tint="@android:color/white"
                        android:padding="2dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnNewMessages"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/button_gradient_blue"
                    android:paddingTop="10dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:layout_gravity="center_horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/ripple_white_rounded"
                    android:contentDescription="New Messages"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="New Messages"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins_medium"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="3.5"/>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/comment"
                        android:contentDescription="@null"
                        app:tint="@android:color/white"
                        android:padding="1dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnRateConsultant"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/button_gradient_blue"
                    android:paddingTop="10dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:layout_gravity="center_horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/ripple_white_rounded"
                    android:contentDescription="Rate your Consultant"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rate your consultant"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins_medium"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="3.5"/>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/rating"
                        android:contentDescription="@null"
                        app:tint="@android:color/white" />
                </LinearLayout>
            </LinearLayout>

            <!-- AI Assistant -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Assistant"
                android:textColor="@color/gradient_end"
                android:textSize="24sp"
                android:fontFamily="@font/poppins_bold"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="156dp"
                android:layout_height="156dp"
                android:padding="16dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/card_neumorphic_background"
                android:orientation="vertical">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/ivAssistant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:background="@color/elements_background"
                    app:srcCompat="@drawable/ai_logo"
                    android:scaleType="centerInside"
                    android:adjustViewBounds="true"
                    app:tint="@null"
                    android:contentDescription="AI Assistant" />
            </LinearLayout>

            <!-- Service Quote -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="360dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_margin="24dp"
                app:cardUseCompatPadding="true"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/card_neumorphic_background">

                    <!-- Title + total chip (fixed vertical constraints) -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/tvQuoteTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Service Quote"
                            android:textColor="@color/gradient_end"
                            android:textSize="20sp"
                            android:fontFamily="@font/poppins_sembold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/chipTotal"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <TextView
                            android:id="@+id/chipTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="Total: R6500"
                            android:textColor="@color/gradient_middle"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins_bold"
                            android:background="@drawable/btn_login"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBaseline_toBaselineOf="@id/tvQuoteTitle"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Subtitle / description -->
                    <TextView
                        android:id="@+id/tvQuoteSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Business Plan Draft"
                        android:textColor="@color/text_dark"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins_medium"
                        android:layout_marginBottom="4dp"/>

                    <!-- Submitted + deadline row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Submitted"
                            android:textColor="@color/text_faded"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins"/>

                        <TextView
                            android:id="@+id/tvDeadline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Deadline: 26/11/2025"
                            android:textColor="@color/text_faded"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins"/>
                    </LinearLayout>

                    <!-- Actions: equal-width buttons, no inset attributes -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAccept"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="6dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="12dp"
                            android:text="Accept"
                            android:textAllCaps="false"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="10sp"
                            app:autoSizeMaxTextSize="12sp"
                            app:autoSizeStepGranularity="1sp"
                            app:iconPadding="0dp"
                            android:textColor="@color/text_light"
                            android:background="@drawable/btn_register"
                            app:backgroundTint="@null"
                            app:cornerRadius="24dp"
                            android:fontFamily="@font/poppins_bold"
                            android:stateListAnimator="@null"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/btnDownloadPDF"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintHorizontal_weight="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDownloadPDF"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="6dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="12dp"
                            android:text="Download"
                            android:textAllCaps="false"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="10sp"
                            app:autoSizeMaxTextSize="12sp"
                            app:autoSizeStepGranularity="1sp"
                            app:iconPadding="0dp"
                            android:textColor="@color/text_light"
                            android:background="@drawable/btn_register"
                            app:backgroundTint="@null"
                            app:cornerRadius="24dp"
                            android:fontFamily="@font/poppins_bold"
                            android:stateListAnimator="@null"
                            app:layout_constraintStart_toEndOf="@id/btnAccept"
                            app:layout_constraintEnd_toStartOf="@id/btnRequestReview"
                            app:layout_constraintTop_toTopOf="@id/btnAccept"
                            app:layout_constraintHorizontal_weight="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRequestReview"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="6dp"
                            android:minWidth="0dp"
                            android:paddingHorizontal="12dp"
                            android:text="Review"
                            android:textAllCaps="false"
                            android:singleLine="true"
                            android:includeFontPadding="false"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="10sp"
                            app:autoSizeMaxTextSize="12sp"
                            app:autoSizeStepGranularity="1sp"
                            app:iconPadding="0dp"
                            android:textColor="@color/text_light"
                            android:background="@drawable/btn_register"
                            app:backgroundTint="@null"
                            app:cornerRadius="24dp"
                            android:fontFamily="@font/poppins_bold"
                            android:stateListAnimator="@null"
                            app:layout_constraintStart_toEndOf="@id/btnDownloadPDF"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@id/btnAccept"
                            app:layout_constraintHorizontal_weight="1" />
                    </androidx.constraintlayout.widget.ConstraintLayout>


                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
