<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardElevation="0dp"
    app:rippleColor="@android:color/white"
    app:strokeColor="@android:color/white"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:backgroundTint="@android:color/white"
        android:background="@drawable/list_row_background">

        <!-- Avatar -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_avatar_circle">

            <ImageView
                android:id="@+id/imgAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:background="@drawable/bg_avatar_circle"
                android:scaleType="centerCrop"
                android:alpha="0.0"
                tools:alpha="1.0" />

            <!-- Initials fallback -->
            <TextView
                android:id="@+id/tvInitials"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_bold"
                tools:text="JS" />
        </FrameLayout>

        <!-- Name + meta -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_medium"
                tools:text="Jane Smith" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_faded"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins"
                    tools:text="jane@university.edu" />

                <TextView
                    android:id="@+id/tvDividerDot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="6dp"
                    android:textColor="@color/text_faded"
                    android:textSize="12sp"
                    android:text="•"
                    android:fontFamily="@font/poppins" />

                <TextView
                    android:id="@+id/tvRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAllCaps="true"
                    android:textColor="@color/gradient_end"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_medium"
                    tools:text="CONSULTANT" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action -->
        <ImageView
            android:id="@+id/ivStartChat"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/new_chat"
            android:src="@drawable/ic_chat"
            app:tint="@color/gradient_end"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
