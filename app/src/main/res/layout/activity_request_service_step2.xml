<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_background"
        tools:context=".RequestServiceStep2Activity">

        <LinearLayout
            android:id="@+id/cardContainer"
            android:layout_width="0dp"
            android:layout_height="680dp"
            android:layout_margin="24dp"
            android:background="@drawable/card_neumorphic_background"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:cardCornerRadius="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="32dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/poppins_bold"
                android:text="Request a Service"
                android:textColor="@color/gradient_end"
                android:textSize="24sp"
                android:textStyle="bold">
            </TextView>

            <ProgressBar
                android:id="@+id/progressService"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="304dp"
                android:layout_height="16dp"
                android:max="100"
                android:progress="50"
                android:layout_marginBottom="16dp"
                android:background="@color/text_light"
                android:progressTint="@color/gradient_end"
                android:progressBackgroundTint="@color/text_light"
                android:padding="8dp"
                android:layout_gravity="center"/>

            <TextView
                android:layout_width="296dp"
                android:layout_height="wrap_content"
                android:paddingLeft="32dp"
                android:fontFamily="@font/poppins_medium"
                android:layout_gravity="left"
                android:text="Step 2 :  Fill out additional \n                information"
                android:textSize="19sp"
                android:textColor="@color/text_dark"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAdditionalInfo"
                android:layout_width="336dp"
                android:layout_height="180dp"
                android:layout_marginHorizontal="12dp"
                android:layout_margin="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/btn_login"
                android:fontFamily="@font/poppins"
                android:inputType="text"
                android:paddingHorizontal="20dp"
                android:textColor="@color/text_faded"
                android:textSize="13sp"
                tools:text="enter additional information" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_margin="8dp"
                android:background="@drawable/btn_register"
                android:fontFamily="@font/poppins_bold"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="Next"
                android:textAllCaps="true"
                android:textColor="@color/text_light"
                app:backgroundTint="@null"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>