<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/serviceCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="10dp"
    app:cardCornerRadius="18dp"
    app:cardUseCompatPadding="true"
    app:cardPreventCornerOverlap="true"
    app:cardBackgroundColor="@android:color/transparent"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_neumorphic_background"
        android:padding="14dp"
        android:clipToPadding="false">

        <!-- Header Row: service category + circular progress with status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tvCategory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Proofreading and Editing"
                android:textSize="12sp"
                android:textColor="@color/text_faded"
                android:fontFamily="@font/poppins_medium" />

            <!-- Circular Progress with Status Below -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="4dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/statusDonut"
                    style="?attr/circularProgressIndicatorStyle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:indicatorDirectionCircular="clockwise"
                    app:indicatorSize="40dp"
                    app:trackThickness="4dp"
                    app:indicatorColor="@color/gradient_middle"
                    app:trackColor="@color/progress_background"
                    android:indeterminate="false"
                    android:progress="50"
                    android:max="100" />

                <TextView
                    android:id="@+id/tvStatusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="in progress"
                    android:textSize="10sp"
                    android:textColor="@color/text_faded"
                    android:fontFamily="@font/poppins"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivChevron"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:contentDescription="navigate"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tvServiceTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Business plan"
            android:textSize="20sp"
            android:textColor="@color/text_dark"
            android:fontFamily="@font/poppins_bold"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Two-line footer: created/updated + chip-like stage text -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical|end"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvStage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="in progress"
                android:textSize="11sp"
                android:textColor="@color/text_faded"
                android:fontFamily="@font/poppins_medium"
                android:background="@drawable/bg_pill_soft" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
