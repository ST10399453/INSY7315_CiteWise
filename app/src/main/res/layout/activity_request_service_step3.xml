<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/main_background"
        tools:context=".RequestServiceStep3Activity">

        <LinearLayout
            android:id="@+id/cardContainer"
            android:layout_width="0dp"
            android:layout_height="656dp"
            android:layout_margin="24dp"
            android:background="@drawable/card_neumorphic_background"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            app:cardCornerRadius="32dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/poppins_bold"
                android:text="Step 3"
                android:textColor="@color/gradient_end"
                android:textSize="32sp"
                android:textStyle="bold">
            </TextView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_sembold"
                android:paddingRight="56dp"
                android:text="Upload your documents"
                android:textSize="19sp"
                android:textColor="@color/text_dark"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp" />

            <ProgressBar
                android:id="@+id/progressService"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="304dp"
                android:layout_height="24dp"
                android:max="100"
                android:progress="75"
                android:progressDrawable="@drawable/custom_progress_bar"
                android:layout_marginBottom="24dp"
                android:layout_gravity="center"
                android:elevation="4dp"/>


            <TextView
                android:id="@+id/tvDocName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="24dp"
                android:fontFamily="@font/poppins_medium"
                android:layout_gravity="left"
                android:text="Document name:"
                android:textSize="16sp"
                android:textColor="@color/text_dark"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDocName"
                android:layout_width="334dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/text_field"
                android:fontFamily="@font/poppins"
                android:inputType="text"
                android:paddingHorizontal="20dp"
                android:textColor="@color/text_faded"
                android:textSize="13sp"
                tools:text="Document name" />

            <TextView
                android:id="@+id/tvAttachFile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="24dp"
                android:fontFamily="@font/poppins_medium"
                android:layout_gravity="left"
                android:text="Attach file"
                android:textSize="16sp"
                android:textColor="@color/text_dark"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAttachFile"
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_margin="8dp"
                android:background="@drawable/btn_login"
                android:fontFamily="@font/poppins_bold"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="Choose file"
                android:textAllCaps="true"
                android:textColor="@color/text_dark"
                app:backgroundTint="@null"/>

            <TextView
                android:id="@+id/tvFileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="No file selected"
                android:textSize="14sp"
                android:textColor="@color/text_dark"
                android:layout_marginBottom="96dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext"
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_margin="8dp"
                android:background="@drawable/btn_register"
                android:fontFamily="@font/poppins_bold"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="Next"
                android:textAllCaps="true"
                android:textColor="@color/text_light"
                app:backgroundTint="@null"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>