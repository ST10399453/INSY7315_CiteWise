<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/greetingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="@android:color/transparent"
                app:cardBackgroundColor="@android:color/transparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_greeting_card"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:baselineAligned="false"
                        tools:ignore="UseCompoundDrawables">

                        <TextView
                            android:id="@+id/tvGreeting"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/public_sans_bold"
                            android:letterSpacing="0.01"
                            android:text="@string/user_dashboard"
                            android:textColor="@color/text_light"
                            android:textSize="30sp" />

                        <ImageView
                            android:id="@+id/logoIcon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginTop="-4dp"
                            android:src="@drawable/logo"
                            app:tint="@android:color/white"
                            android:contentDescription="@string/app_name" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/subtitleText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="8dp"
                        android:text="Here's what's happening with your tasks today."
                        android:textColor="#E0EBECF0"
                        android:textSize="16sp"
                        android:fontFamily="@font/public_sans_medium" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone">
                    <!-- Maybe bring this back                       -->

                        <TextView
                            android:id="@+id/chipNewAssigned"
                            style="@style/SummaryChip"
                            android:text="3 New Assigned"
                            android:background="@drawable/chip_new_assigned"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:id="@+id/chipUrgent"
                            style="@style/SummaryChip"
                            android:text="1 Urgent"
                            android:background="@drawable/chip_urgent" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Assigned to me -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assigned to me"
                android:textColor="@color/gradient_end"
                android:textSize="24sp"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/poppins_bold"
                android:layout_marginTop="8dp"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/serviceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:cardCornerRadius="20dp"
            app:cardUseCompatPadding="true"
            app:strokeColor="@android:color/transparent"
            app:cardBackgroundColor="@android:color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_card_background">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/urgencyFilterGroup"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginHorizontal="0dp"
                android:layout_marginBottom="16dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterAll"
                    style="@style/Widget.CiteWise.ProfileToggle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="All"
                    android:checkable="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterUrgent"
                    style="@style/Widget.CiteWise.ProfileToggle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Urgent"
                    android:checkable="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterMedium"
                    style="@style/Widget.CiteWise.ProfileToggle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Medium"
                    android:checkable="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterLow"
                    style="@style/Widget.CiteWise.ProfileToggle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Low"
                    android:checkable="true" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tasksRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                tools:listitem="@layout/item_service_review"
                tools:itemCount="3" />

                <TextView
                    android:id="@+id/tvEmptyRequests"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No service requests"
                    android:textColor="@android:color/darker_gray"
                    android:textSize="16sp"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"/>
            </FrameLayout>

            <TextView
                android:id="@+id/tvViewAllTasks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View all active tasks >"
                android:textColor="@color/gradient_end"
                android:fontFamily="@font/poppins_sembold"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"/>
        </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

            <!-- Schedule -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Schedule"
                android:textColor="@color/gradient_end"
                android:textSize="24sp"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/poppins_bold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_card_background"
                android:padding="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="August 2025"
                        android:fontFamily="@font/poppins_medium"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/sharp_arrow_drop_down_24"/>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/scheduleRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_service_review"
                    tools:itemCount="1" />
            </LinearLayout>

            <!-- Notifications -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notifications"
                android:textColor="@color/gradient_end"
                android:textSize="24sp"
                android:fontFamily="@font/poppins_bold"
                android:layout_marginTop="24dp"
                android:layout_marginStart="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/notifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:cardCornerRadius="20dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="@android:color/transparent"
                app:cardBackgroundColor="@android:color/transparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/rounded_card_background"
                    android:padding="16dp">

                    <!-- Notification Items -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp">

                        <!-- Missing-->
                        <LinearLayout
                            android:id="@+id/btnMissingDocuments"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:paddingVertical="12dp"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_missing_doc"
                                android:contentDescription="@string/app_name" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/public_sans_medium"
                                android:text="overdue tasks"
                                android:textColor="@color/gradient_end"
                                android:textSize="16sp" />

                            <ImageView
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:contentDescription="@string/open_notification"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/gradient_end" />
                        </LinearLayout>

                        <!-- Feedback -->
                        <LinearLayout
                            android:id="@+id/btnFeedback"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:paddingVertical="12dp"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_feedback"
                                android:contentDescription="@string/app_name" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/public_sans_medium"
                                android:text="Feedback"
                                android:textColor="@color/gradient_end"
                                android:textSize="16sp" />

                            <ImageView
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:src="@drawable/ic_chevron_right"
                                android:contentDescription="@string/open_notification"
                                app:tint="@color/gradient_end" />
                        </LinearLayout>

                        <!-- Msg -->
                        <LinearLayout
                            android:id="@+id/btnNewMessages"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:paddingVertical="12dp"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_new_messages"
                                android:contentDescription="@string/app_name" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/public_sans_medium"
                                android:text="@string/_1_new_message"
                                android:textColor="@color/gradient_end"
                                android:textSize="16sp" />

                            <ImageView
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:src="@drawable/ic_chevron_right"
                                android:contentDescription="@string/open_notification"
                                app:tint="@color/gradient_end" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

<!--            <LinearLayout-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:orientation="vertical"-->
<!--                android:background="@drawable/rounded_card_background"-->
<!--                android:padding="16dp">-->

<!--                <include layout="@layout/include_consultant_notifications" />-->
<!--            </LinearLayout>-->

            <!-- Quote requests -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quote requests"
                android:textColor="@color/gradient_end"
                android:textSize="24sp"
                android:fontFamily="@font/poppins_bold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/quoteRequestsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:background="@drawable/rounded_card_background"
                tools:itemCount="3"
                android:visibility="gone"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom nav uses the shared shell in activity_base -->
</androidx.constraintlayout.widget.ConstraintLayout>
