<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootCoordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    tools:context=".ResourcesActivity">

    <!-- Column: header + filters + list -->
    <LinearLayout
        android:id="@+id/contentColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="0dp">

        <!-- Simple header (no AppBar) -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resources"
            android:textColor="@color/gradient_end"
            android:textSize="24sp"
            android:fontFamily="@font/poppins_sembold"/>

        <TextView
            android:id="@+id/tvSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Browse, filter and download helpful documents."
            android:textColor="@color/text_faded"
            android:textSize="12sp"
            android:fontFamily="@font/poppins"/>

        <!-- Card with search + exposed dropdowns -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="20dp"
            app:strokeColor="@android:color/transparent"
            app:cardUseCompatPadding="true"
            app:cardBackgroundColor="@android:color/transparent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_neumorphic_background"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <!-- Search -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Search documents"
                    android:layout_marginBottom="6dp"
                    android:textSize="12sp"
                    android:textColor="@color/text_dark"
                    android:fontFamily="@font/poppins_medium"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSearch"
                    style="@style/Widget.Material3.TextInputLayout.FilledBox.Dense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:startIconDrawable="@drawable/ic_search_blue">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/outline_edittext"
                        android:hint="Type to search"
                        android:imeOptions="actionSearch"
                        android:singleLine="true"
                        android:textColor="@color/text_dark"
                        android:textColorHint="@color/text_dark"
                        android:fontFamily="@font/poppins"
                        android:textSize="14sp"
                        android:contentDescription="Search resources"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Filters: exposed dropdowns -->
                <LinearLayout
                    android:id="@+id/rowFilters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp">

                    <!-- Visibility -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Visibility"
                        android:textColor="@color/text_dark"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins_medium"
                        android:layout_marginBottom="6dp"
                        android:visibility="gone"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilVisibility"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="false"
                        app:endIconMode="dropdown_menu"
                        app:endIconDrawable="@drawable/ic_down_arrow"
                        app:endIconTint="@null"
                        android:visibility="gone">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actVisibility"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:inputType="none"
                            android:hint="All"
                            android:textSize="14sp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textColor="@color/text_dark"
                            android:background="@drawable/outline_edittext"
                            android:textColorHint="@color/text_dark"
                            android:popupBackground="@drawable/bg_spinner_popup_white"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Faculty -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Faculty"
                        android:textColor="@color/text_dark"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins_medium"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="6dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilFaculty"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="false"
                        app:endIconMode="dropdown_menu"
                        app:endIconDrawable="@drawable/ic_down_arrow"
                        app:endIconTint="@null">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actFaculty"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:inputType="none"
                            android:hint="All"
                            android:textSize="14sp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:background="@drawable/outline_edittext"
                            android:textColor="@color/text_dark"
                            android:textColorHint="@color/text_dark"
                            android:popupBackground="@drawable/bg_spinner_popup_white"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Sort -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sort"
                        android:textColor="@color/text_dark"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins_medium"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="6dp"
                        android:visibility="gone"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilSort"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="false"
                        app:endIconMode="dropdown_menu"
                        app:endIconDrawable="@drawable/ic_down_arrow"
                        app:endIconTint="@null"
                        android:visibility="gone">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actSort"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:inputType="none"
                            android:hint="Newest first"
                            android:textSize="14sp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textColor="@color/text_dark"
                            android:textColorHint="@color/text_faded"
                            android:popupBackground="@drawable/bg_spinner_popup_white"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDocuments"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingBottom="88dp"
            android:clipToPadding="false"
            tools:listitem="@layout/item_document_card" />
    </LinearLayout>

    <!-- Offline state -->
    <LinearLayout
        android:id="@+id/stateNoInternet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone"
        android:clickable="false">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_signal_off"
            android:contentDescription="No internet"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No internet connection"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:layout_marginTop="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Retry"
            android:textAllCaps="false"
            android:textColor="@color/text_dark"
            android:background="@drawable/btn_login"
            app:backgroundTint="@null"
            android:layout_marginTop="12dp"/>
    </LinearLayout>

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/stateEmpty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone"
        android:clickable="false">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_resources"
            android:contentDescription="No resources"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nothing to show"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:layout_marginTop="12dp"/>
    </LinearLayout>

    <!-- FAB overlay -->
    <FrameLayout
        android:id="@+id/fabOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false">

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add"
            android:contentDescription="Add resource"
            android:visibility="gone"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/gradient_end"
            android:tint="@android:color/white"
            app:icon="@drawable/ic_add"/>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
