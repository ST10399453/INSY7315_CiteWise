<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_background"
    tools:context=".ConsultantTaskDetailsActivity">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="48dp"
        android:contentDescription="Back"
        android:padding="12dp"
        android:src="@drawable/ic_back_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Task Details"
        android:textColor="@color/gradient_end"
        android:textSize="28sp"
        android:fontFamily="@font/poppins_extra_bold"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        android:layout_marginStart="16dp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/rounded_card_background"
                android:elevation="2dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvServiceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Proofreading &amp; Editing"
                    android:textSize="20sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/text_dark" />

                <TextView
                    android:id="@+id/tvDeadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Deadline: 28/10/2025"
                    android:textSize="14sp"
                    android:textColor="@color/text_faded"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvStudent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Student: Alicia Orren"
                    android:textSize="14sp"
                    android:textColor="@color/text_faded"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/chipPriority"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Low"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:background="@drawable/priority_tag_background"
                    android:textColor="@color/text_light"
                    android:layout_gravity="end"
                    android:layout_marginTop="-40dp"
                    android:layout_marginEnd="8dp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Files"
                android:textSize="24sp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/gradient_end"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:id="@+id/cardQualitativeStudy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/rounded_card_background"
                android:elevation="2dp"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Qualitative Study"
                    android:textSize="16sp"
                    android:textColor="@color/text_dark"/>
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_doc_preview_placeholder"
                    android:contentDescription="Document" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/rounded_card_background"
                android:elevation="2dp"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Upload feedback"
                    android:textSize="16sp"
                    android:textColor="@color/text_dark"/>

                <Button
                    android:id="@+id/btnUploadFeedback"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upload"
                    android:textColor="@color/text_light"
                    android:backgroundTint="@color/gradient_end"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/versionHistoryPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_card_background"
                android:elevation="2dp"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvVersionHistoryHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Version history"
                    android:textSize="16sp"
                    android:textColor="@color/text_dark"
                    android:drawableEnd="@drawable/sharp_arrow_drop_down_24"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/versionHistoryContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        style="@style/VersionHistoryItem"
                        android:text="Original version" />
                    <TextView
                        style="@style/VersionHistoryItem"
                        android:text="Annotated version 1" />
                    <TextView
                        style="@style/VersionHistoryItem"
                        android:text="Annotated version 2"
                        android:drawableEnd="@drawable/ic_circle_check" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Progress Status"
                android:textSize="24sp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/gradient_end"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:id="@+id/progressStatusPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/rounded_card_background"
                android:elevation="2dp"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvProgressStatusHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Update progress status"
                    android:textSize="16sp"
                    android:textColor="@color/text_dark"
                    android:drawableEnd="@drawable/sharp_arrow_drop_down_24"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Progress status"
                    android:textColor="@color/text_faded"
                    android:background="@drawable/bg_spinner_popup_white"
                    android:drawableEnd="@drawable/sharp_arrow_drop_down_24" />

                <LinearLayout
                    android:id="@+id/progressHistoryContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        style="@style/ProgressStatusItem"
                        android:text="Submitted"
                        android:drawableStart="@drawable/ic_dot_green" />
                    <TextView
                        style="@style/ProgressStatusItem"
                        android:text="In Progress"
                        android:drawableStart="@drawable/ic_dot_yellow" />
                    <TextView
                        style="@style/ProgressStatusItem"
                        android:text="Awaiting Feedback"
                        android:drawableStart="@drawable/ic_dot_purple"
                        android:drawableEnd="@drawable/ic_circle_check" />
                    <TextView
                        style="@style/ProgressStatusItem"
                        android:text="Completed"
                        android:drawableStart="@drawable/ic_dot_blue" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto-generated Quote"
                android:textSize="24sp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/gradient_end"
                android:layout_marginBottom="12dp"/>

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="*">

                <TableRow
                    android:background="@color/gradient_end"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">
                    <TextView
                        android:id="@+id/tvWordCount"
                        android:text="Word Count"
                        android:textColor="@color/text_light"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_medium"/>
                    <TextView
                        android:id="@+id/tvCostPerWord"
                        android:text="Cost/word"
                        android:textColor="@color/text_light"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_medium"/>
                    <TextView
                        android:id="@+id/tvUrgencyIncrease"
                        android:text="Urgency increase"
                        android:textColor="@color/text_light"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_medium"/>
                    <TextView
                        android:id="@+id/tvTotalQuote"
                        android:text="Total"
                        android:textColor="@color/text_light"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_medium"/>
                </TableRow>

                <TableRow
                    android:background="@color/ui_background"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">
                    <TextView
                        android:text="8 000"
                        android:textColor="@color/text_dark"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_medium"/>
                    <TextView
                        android:text="15c"
                        android:textColor="@color/text_dark"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_medium"/>
                    <TextView
                        android:text="n/a"
                        android:textColor="@color/text_dark"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_medium"/>
                    <TextView
                        android:text="R 1 200"
                        android:textColor="@color/text_dark"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_bold"/>
                </TableRow>
            </TableLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="100dp">

                <Button
                android:id="@+id/btnRevise"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Revise"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:textColor="@color/gradient_end"
                android:textAllCaps="true"
                app:strokeColor="@color/gradient_end"
                android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnSendToStudent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Send to student"
                    android:textColor="@color/text_light"
                    android:textAllCaps="true"
                    android:backgroundTint="@color/gradient_end"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnDownloadPdf"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Download Pdf"
                    android:textColor="@color/text_light"
                    android:textAllCaps="true"
                    android:backgroundTint="@color/gradient_end" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>