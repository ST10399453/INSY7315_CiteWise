<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="72dp"
    android:padding="12dp"
    android:background="@color/ui_background">

    <!-- Initials bubble -->
    <TextView
        android:id="@+id/tvInitial"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:fontFamily="@font/poppins_bold"
        android:background="@drawable/bg_avatar_circle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Right-side action buttons (tick/cross) -->
    <LinearLayout
        android:id="@+id/actionGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvInitial"
        app:layout_constraintBottom_toBottomOf="@id/tvInitial">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnReject"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_outline"
            android:contentDescription="@string/reject"
            android:padding="0dp"
            android:scaleType="center"
            app:srcCompat="@drawable/ic_close_24"
            app:tint="@android:color/holo_red_light" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnAccept"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_filled"
            android:contentDescription="@string/accept"
            android:padding="0dp"
            android:scaleType="center"
            app:srcCompat="@drawable/ic_check_24"
            app:tint="@color/green_500" />
    </LinearLayout>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/actionsBarrier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:barrierDirection="start"
        app:barrierAllowsGoneWidgets="false"
        app:constraint_referenced_ids="actionGroup" />

    <!-- Top line: email -->
    <TextView
        android:id="@+id/tvUsername"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textColor="@color/gradient_middle"
        android:fontFamily="@font/poppins"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/tvInitial"
        app:layout_constraintTop_toTopOf="@id/tvInitial"
        app:layout_constraintEnd_toStartOf="@id/actionsBarrier"
        android:layout_marginStart="12dp" />

    <!-- Second line: first name -->
    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/text_dark"
        android:fontFamily="@font/poppins_sembold"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintStart_toStartOf="@id/tvUsername"
        app:layout_constraintTop_toBottomOf="@id/tvUsername"
        app:layout_constraintEnd_toStartOf="@id/actionsBarrier" />

</androidx.constraintlayout.widget.ConstraintLayout>
