    <!-- STEP 3 -->
    <!--  DO NOT CHANGE THIS " android:layout_marginBottom="170dp"  -->
    <LinearLayout
        android:id="@+id/sectionStep3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@drawable/card_neumorphic_background"
        android:padding="20dp"
        android:visibility="gone"
        android:layout_marginTop="32dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="170dp"
        app:layout_constraintTop_toBottomOf="@id/tvHeader"
        app:layout_constraintBottom_toTopOf="@id/btnNext"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/upload_your_documents"
            android:textColor="@color/text_dark"
            android:fontFamily="@font/poppins_sembold"
            android:textSize="18sp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/document_name"
            android:textColor="@color/text_dark"
            android:fontFamily="@font/poppins_medium"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDocName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/textfieldmain"
            android:fontFamily="@font/poppins"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_dark"
            android:textSize="14sp"
            android:layout_marginBottom="18dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/attach_file"
            android:textColor="@color/text_dark"
            android:fontFamily="@font/poppins_medium"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <!-- Upload Box -->
        <LinearLayout
            android:id="@+id/btnAttachFile"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_dashed_border"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/iconUpload"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_file_upload"
                android:layout_marginBottom="8dp"
                app:tint="@color/gradient_end" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="32dp"
                    android:layout_height="1.5dp"
                    android:background="@color/gradient_end"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/txtSelectFile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select a file"
                    android:textColor="#757575"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins_medium" />

                <View
                    android:layout_width="32dp"
                    android:layout_height="1.5dp"
                    android:background="@color/gradient_end"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_file_selected"
            android:textColor="@color/text_dark"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_medium"
            android:layout_marginTop="12dp" />

        <ProgressBar
            android:id="@+id/progressUpload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>


    <!-- STEP 4 -->
    <!--  DO NOT CHANGE THIS " android:layout_marginBottom="170dp"  -->
    <LinearLayout
        android:id="@+id/sectionStep4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@drawable/card_neumorphic_background"
        android:padding="20dp"
        android:visibility="visible"
        android:layout_marginTop="32dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="170dp"
        app:layout_constraintTop_toBottomOf="@id/tvHeader"
        app:layout_constraintBottom_toTopOf="@id/btnNext"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/level_of_urgency"
            android:textColor="@color/text_dark"
            android:fontFamily="@font/poppins_sembold"
            android:textSize="18sp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_urgency"
            android:textColor="@color/text_dark"
            android:fontFamily="@font/poppins_medium"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

<!--        <Spinner-->
<!--            android:id="@+id/urgencySpinner"-->
<!--            android:layout_width="match_parent"-->
<!--            android:layout_height="48dp"-->
<!--            android:background="@drawable/text_field"-->
<!--            android:drawableEnd="@drawable/ic_calendar"-->
<!--            android:drawablePadding="8dp"-->
<!--            android:popupBackground="@drawable/bg_spinner_popup_white"-->
<!--            android:paddingStart="8dp"-->
<!--            android:layout_marginBottom="16dp"/>-->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/urgencyLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:hintEnabled="false"
            app:endIconDrawable="@drawable/ic_down_arrow"
            app:endIconTint="@null"
            android:textSize="14sp"
            app:endIconMode="dropdown_menu"
            android:layout_marginBottom="16dp">

            <AutoCompleteTextView
                android:id="@+id/dropdownUrgency"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="gg"
                android:textSize="14sp"
                android:background="@drawable/textfieldmain"
                android:popupBackground="@drawable/bg_spinner_popup_white"
                android:inputType="none"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@android:color/black"
                android:textColorHint="@android:color/darker_gray"/>
        </com.google.android.material.textfield.TextInputLayout>

<!--        android:dropDownWidth="170dp"-->
<!--        android:dropDownHeight="480dp"-->
<!--        android:dropDownVerticalOffset="-12dp"-->
<!--        android:dropDownHorizontalOffset="155dp"-->

        <TextView
            android:id="@+id/tvDeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_a_date"
            android:textColor="@color/text_dark"
            android:fontFamily="@font/poppins_medium"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDeadline"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/textfieldmain"
            android:hint="@string/select_a_date"
            android:drawableEnd="@drawable/ic_calendar"
            android:drawablePadding="8dp"
            android:focusable="false"
            android:inputType="none"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_dark"
            android:drawableTint="@color/gradient_end"
            android:textSize="14sp"/>
    </LinearLayout>

    <!-- SUCCESS -->
    <!--  DO NOT CHANGE THIS " android:layout_marginBottom="170dp"  -->
    <LinearLayout
        android:id="@+id/sectionStep5Success"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/card_neumorphic_background"
        android:padding="24dp"
        android:visibility="gone"
        android:layout_marginTop="32dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="170dp"
        app:layout_constraintTop_toBottomOf="@id/tvHeader"
        app:layout_constraintBottom_toTopOf="@id/btnNext"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/circle_request_success"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/your_request_submitted"
            android:textAlignment="center"
            android:textColor="@color/gradient_end"
            android:fontFamily="@font/poppins_sembold"
            android:textSize="20sp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quotation_note"
            android:textAlignment="center"
            android:textColor="@color/text_faded"
            android:fontFamily="@font/poppins"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

    </LinearLayout>

    <!-- Primary CTA -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="@string/next"
        android:textAllCaps="false"
        android:textColor="@color/text_light"
        android:background="@drawable/btn_register"
        app:backgroundTint="@null"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>
