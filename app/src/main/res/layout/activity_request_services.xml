<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_background"
    android:paddingTop="32dp"
    android:paddingBottom="20dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tvSetupProfile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/request_service"
        android:fontFamily="@font/poppins_sembold"
        android:textColor="@color/gradient_end"
        android:textSize="20sp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Animated horizontal progress -->
    <ProgressBar
        android:id="@+id/progressService"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/custom_progress_bar"
        android:layout_marginTop="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvSetupProfile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Step header -->
    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/step_1"
        android:fontFamily="@font/poppins_bold"
        android:textColor="@color/gradient_end"
        android:textSize="32sp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/progressService"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- ===== Sections ===== -->

    <!-- STEP 1 -->
    <LinearLayout
        android:id="@+id/sectionStep1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@drawable/card_neumorphic_background"
        android:padding="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvHeader"
        app:layout_constraintBottom_toTopOf="@id/btnNext"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_a_service"
            android:textColor="@color/text_dark"
            android:fontFamily="@font/poppins_sembold"
            android:textSize="18sp"
            android:layout_marginBottom="12dp"/>

        <Spinner
            android:id="@+id/serviceSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/btn_login"
            android:popupBackground="@drawable/bg_spinner_popup_white"
            android:paddingLeft="8dp"/>
    </LinearLayout>

    <!-- STEP 2 -->
    <LinearLayout
        android:id="@+id/sectionStep2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@drawable/card_neumorphic_background"
        android:padding="20dp"
        android:visibility="gone"
        android:layout_marginTop="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvHeader"
        app:layout_constraintBottom_toTopOf="@id/btnNext"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fill_additional_information"
            android:textColor="@color/text_dark"
            android:fontFamily="@font/poppins_sembold"
            android:textSize="18sp"
            android:layout_marginBottom="12dp"/>

        <ProgressBar
            android:layout_width="match_parent"
            android:layout_height="8dp"
            style="?android:attr/progressBarStyleHorizontal"
            android:progress="65"
            android:max="100"
            android:progressDrawable="@drawable/custom_progress_bar_small"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAdditionalInfo"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@drawable/text_field"
            android:hint="@string/enter_additional_information"
            android:fontFamily="@font/poppins"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_dark"
            android:textSize="14sp"/>
    </LinearLayout>

    <!-- STEP 3 -->
    <LinearLayout
        android:id="@+id/sectionStep3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@drawable/card_neumorphic_background"
        android:padding="20dp"
        android:visibility="gone"
        android:layout_marginTop="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvHeader"
        app:layout_constraintBottom_toTopOf="@id/btnNext"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/upload_your_documents"
            android:textColor="@color/text_dark"
            android:fontFamily="@font/poppins_sembold"
            android:textSize="18sp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/document_name"
            android:textColor="@color/text_dark"
            android:fontFamily="@font/poppins_medium"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDocName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/text_field"
            android:hint="@string/document_name_hint"
            android:fontFamily="@font/poppins"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_dark"
            android:textSize="14sp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/attach_file"
            android:textColor="@color/text_dark"
            android:fontFamily="@font/poppins_medium"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAttachFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_login"
            android:text="@string/choose_file"
            android:textAllCaps="true"
            android:textColor="@color/text_dark"
            app:backgroundTint="@null"/>

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_file_selected"
            android:textColor="@color/text_dark"
            android:textSize="14sp"
            android:layout_marginTop="8dp"/>

        <ProgressBar
            android:id="@+id/progressUpload"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

    <!-- STEP 4 -->
    <LinearLayout
        android:id="@+id/sectionStep4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@drawable/card_neumorphic_background"
        android:padding="20dp"
        android:visibility="gone"
        android:layout_marginTop="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvHeader"
        app:layout_constraintBottom_toTopOf="@id/btnNext"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/level_of_urgency"
            android:textColor="@color/text_dark"
            android:fontFamily="@font/poppins_sembold"
            android:textSize="18sp"
            android:layout_marginBottom="12dp"/>

        <Spinner
            android:id="@+id/urgencySpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/btn_login"
            android:popupBackground="@drawable/bg_spinner_popup_white"
            android:paddingLeft="8dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/tvDeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/deadline"
            android:textColor="@color/text_dark"
            android:fontFamily="@font/poppins_medium"
            android:textSize="16sp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDeadline"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/btn_login"
            android:hint="@string/select_a_date"
            android:drawableEnd="@drawable/ic_calendar"
            android:drawablePadding="8dp"
            android:focusable="false"
            android:inputType="none"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_dark"
            android:drawableTint="@color/gradient_end"
            android:textSize="14sp"/>
    </LinearLayout>

    <!-- SUCCESS -->
    <LinearLayout
        android:id="@+id/sectionStep5Success"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/card_neumorphic_background"
        android:padding="24dp"
        android:visibility="gone"
        android:layout_marginTop="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvHeader"
        app:layout_constraintBottom_toTopOf="@id/btnNext"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/circle_request_success"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/your_request_submitted"
            android:textAlignment="center"
            android:textColor="@color/gradient_end"
            android:fontFamily="@font/poppins_sembold"
            android:textSize="20sp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quotation_note"
            android:textAlignment="center"
            android:textColor="@color/text_faded"
            android:fontFamily="@font/poppins"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/done"
            android:background="@drawable/btn_register"
            android:textAllCaps="true"
            android:textColor="@color/text_light"
            app:backgroundTint="@null"/>
    </LinearLayout>

    <!-- Primary CTA -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="@string/next"
        android:textAllCaps="false"
        android:textColor="@color/text_light"
        android:background="@drawable/btn_register"
        app:backgroundTint="@null"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>
