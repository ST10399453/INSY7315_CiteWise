<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:padding="16dp">

    <RelativeLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back_arrow"
            app:tint="@color/gradient_end"
            android:layout_marginStart="8dp"
            android:contentDescription="back"
            android:clickable="true"
            android:focusable="true"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:padding="8dp" />

        <!-- Title -->
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/request_service"
            android:textColor="@color/gradient_end"
            android:textSize="26sp"
            android:fontFamily="@font/public_sans_medium"
            android:layout_centerInParent="true"/>

    </RelativeLayout>

    <!-- Animated horizontal progress -->
    <ProgressBar
        android:id="@+id/progressService"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/custom_progress_bar"
        android:layout_marginTop="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Step header -->
    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/step_1"
        app:layout_constraintTop_toBottomOf="@id/progressService"
        app:layout_constraintStart_toStartOf="parent"
        android:visibility="gone"/>


    <!-- ===== Sections ===== -->
    <!-- STEP 1 -->
    <!--  DO NOT CHANGE THIS " android:layout_marginBottom="170dp"  -->
    <LinearLayout
        android:id="@+id/sectionStep1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@drawable/card_neumorphic_background"
        android:padding="18dp"
        android:visibility="gone"
        android:layout_marginTop="32dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="170dp"
        app:layout_constraintTop_toBottomOf="@id/tvHeader"
        app:layout_constraintBottom_toTopOf="@id/btnNext"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_a_service"
            android:textColor="@color/text_dark"
            android:fontFamily="@font/poppins_sembold"
            android:textSize="18sp"
            android:layout_marginBottom="12dp"/>

        <!-- ✅ Radio group replaces Spinner -->
        <RadioGroup
            android:id="@+id/serviceRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbProofreading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Proofreading &amp; Editing"
                android:textSize="16sp"
                android:button="@null"
                android:drawableStart="@drawable/radio_button_selector"
                android:drawablePadding="8dp"
                android:textColor="@color/text_dark"
                android:fontFamily="@font/public_sans_medium"
                android:paddingVertical="12dp"
                android:paddingHorizontal="2dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:includeFontPadding="false" />

            <RadioButton
                android:id="@+id/rbFormatting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Formatting &amp; Referencing"
                android:textSize="16sp"
                android:button="@null"
                android:drawableStart="@drawable/radio_button_selector"
                android:drawablePadding="8dp"
                android:textColor="@color/text_dark"
                android:fontFamily="@font/public_sans_medium"
                android:paddingVertical="12dp"
                android:paddingHorizontal="2dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:includeFontPadding="false" />

            <RadioButton
                android:id="@+id/rbDataAnalysis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Data Analysis Support"
                android:textSize="16sp"
                android:button="@null"
                android:drawableStart="@drawable/radio_button_selector"
                android:drawablePadding="8dp"
                android:textColor="@color/text_dark"
                android:fontFamily="@font/public_sans_medium"
                android:paddingVertical="12dp"
                android:paddingHorizontal="2dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:includeFontPadding="false" />

            <RadioButton
                android:id="@+id/rbResearchCoaching"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Research/Methodology Coaching"
                android:textSize="16sp"
                android:button="@null"
                android:drawableStart="@drawable/radio_button_selector"
                android:drawablePadding="8dp"
                android:textColor="@color/text_dark"
                android:fontFamily="@font/public_sans_medium"
                android:paddingVertical="12dp"
                android:paddingHorizontal="2dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:includeFontPadding="false" />


            <RadioButton
                android:id="@+id/rbTranslation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Translation"
                android:textSize="16sp"
                android:button="@null"
                android:drawableStart="@drawable/radio_button_selector"
                android:drawablePadding="8dp"
                android:textColor="@color/text_dark"
                android:fontFamily="@font/public_sans_medium"
                android:paddingVertical="12dp"
                android:paddingHorizontal="2dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:includeFontPadding="false" />
        </RadioGroup>
    </LinearLayout>


    <!-- STEP 2 -->
    <!--  DO NOT CHANGE THIS " android:layout_marginBottom="170dp"  -->
    <LinearLayout
        android:id="@+id/sectionStep2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@drawable/card_neumorphic_background"
        android:padding="20dp"
        android:visibility="gone"
        android:layout_marginTop="32dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="170dp"
        app:layout_constraintTop_toBottomOf="@id/tvHeader"
        app:layout_constraintBottom_toTopOf="@id/btnNext"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fill_additional_information"
            android:textColor="@color/text_dark"
            android:fontFamily="@font/poppins_sembold"
            android:textSize="18sp"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAdditionalInfo"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:background="@drawable/textfieldmain"
            android:hint="@string/enter_additional_information"
            android:fontFamily="@font/public_sans_medium"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:overScrollMode="always"
            android:textColor="@color/text_dark"
            android:textColorHint="#757575"
            android:textSize="15sp" />

    </LinearLayout>

