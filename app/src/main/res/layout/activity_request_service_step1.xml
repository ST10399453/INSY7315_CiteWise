<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_background"
    tools:context=".RequestServiceStep1Activity">

    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="0dp"
        android:layout_height="656dp"
        android:layout_margin="24dp"
        android:background="@drawable/card_neumorphic_background"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:cardCornerRadius="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/poppins_bold"
            android:text="Step 1"
            android:textColor="@color/gradient_end"
            android:textSize="32sp"
            android:textStyle="bold">
        </TextView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_sembold"
            android:paddingRight="144dp"
            android:text="Select a service"
            android:textSize="19sp"
            android:textColor="@color/text_dark"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="16dp" />

        <ProgressBar
            android:id="@+id/progressService"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="304dp"
            android:layout_height="24dp"
            android:max="100"
            android:progress="25"
            android:progressDrawable="@drawable/custom_progress_bar"
            android:layout_marginBottom="24dp"
            android:layout_gravity="center"
            android:elevation="4dp"/>


        <Spinner
            android:id="@+id/serviceSpinner"
            android:layout_width="328dp"
            android:layout_height="48dp"
            android:layout_marginBottom="280dp"
            android:background="@drawable/btn_login"
            android:lineSpacingExtra="4dp"
            android:paddingLeft="8dp">

        </Spinner>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_margin="8dp"
            android:background="@drawable/btn_register"
            android:fontFamily="@font/poppins_bold"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="Next"
            android:textAllCaps="true"
            android:textSize="16sp"
            android:textColor="@color/text_light"
            app:backgroundTint="@null"/>
        </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>