<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardUseCompatPadding="true"
    app:cardCornerRadius="16dp"
    app:strokeColor="@color/progress_background"
    app:strokeWidth="1dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cover -->
        <ImageView
            android:id="@+id/imgCover"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:scaleType="centerCrop"
            android:contentDescription="Document cover"
            android:src="@drawable/ic_doc_preview_placeholder" />

        <!-- Title row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvDocName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Document name.pdf"
                android:textSize="14sp"
                android:textColor="@color/text_dark"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_toStartOf="@+id/btnOverflow"
                android:layout_alignParentStart="true" />

            <ImageButton
                android:id="@+id/btnOverflow"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="More"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/text_dark" />
        </RelativeLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
