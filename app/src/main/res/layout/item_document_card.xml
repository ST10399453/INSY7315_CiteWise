<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardUseCompatPadding="true"
    app:cardCornerRadius="18dp"
    app:strokeColor="@android:color/transparent"
    app:cardBackgroundColor="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_neumorphic_background"
        android:orientation="vertical">

        <!-- Cover / file icon area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:padding="12dp">

            <ImageView
                android:id="@+id/imgCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/btn_login"
                android:contentDescription="Cover"/>

            <!-- (Optional) little badge could be added here if you want -->
        </FrameLayout>

        <!-- Meta row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDocName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="Document name.pdf"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_medium"/>

            <ImageButton
                android:id="@+id/btnOverflow"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Menu"
                android:src="@drawable/ic_overflow"/>
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
