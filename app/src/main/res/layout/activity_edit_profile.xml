<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background">

    <ImageView
        android:id="@+id/btnBack"
        style="@style/BackArrowStyle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvHeaderTitle"
        style="@style/HeaderTitleStyle"
        android:text="Edit Profile"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Full name -->
        <TextView style="@style/InputLabel" android:text="Full name" />
        <EditText
            android:id="@+id/etFullName"
            style="@style/SettingsInput"
            tools:text="Erin Chisholm"
            android:inputType="textPersonName" />

        <!-- Phone number -->
        <TextView style="@style/InputLabel" android:text="Phone number" />
        <EditText
            android:id="@+id/etPhone"
            style="@style/SettingsInput"
            tools:text="078 123 4567"
            android:inputType="phone" />

        <!-- Email -->
        <TextView style="@style/InputLabel" android:text="Email address" />
        <EditText
            android:id="@+id/etEmail"
            style="@style/SettingsInput"
            tools:text="erin@consult.com"
            android:inputType="textEmailAddress" />

        <!-- Field of study -->
        <TextView style="@style/InputLabel" android:text="Field of study" />
        <EditText
            android:id="@+id/etFieldOfStudy"
            style="@style/SettingsInput"
            tools:text="Computer Science"
            android:inputType="textCapWords" />

        <!-- Institution -->
        <TextView style="@style/InputLabel" android:text="Institution" />
        <EditText
            android:id="@+id/etInstitution"
            style="@style/SettingsInput"
            tools:text="CiteWise"
            android:inputType="textCapWords" />

        <!-- Save button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/btn_register"
            android:fontFamily="@font/poppins_bold"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="SAVE"
            android:textAllCaps="true"
            android:textColor="@color/text_light"
            android:textSize="16sp"
            app:backgroundTint="@null"/>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
