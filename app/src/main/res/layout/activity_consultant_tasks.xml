<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    tools:context=".ConsultantTasksActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingBottom="72dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="24dp">

            <!-- Header Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_back_arrow"
                    android:contentDescription="Back"
                    android:layout_centerVertical="true" />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="57dp"
                    android:layout_toEndOf="@id/btnBack"
                    android:fontFamily="@font/poppins_extra_bold"
                    android:text="Active Tasks"
                    android:textColor="@color/gradient_end"
                    android:textSize="28sp" />
            </RelativeLayout>

            <!-- Urgency Filter (pill toggle like Manage Consultants) -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/urgencyFilterGroup"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/toggle_group_track"
                android:clipToPadding="false"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterAll"
                    style="@style/Widget.CiteWise.ProfileToggle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="All"
                    android:checkable="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterUrgent"
                    style="@style/Widget.CiteWise.ProfileToggle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Urgent"
                    android:checkable="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterMedium"
                    style="@style/Widget.CiteWise.ProfileToggle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Medium"
                    android:checkable="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/filterLow"
                    style="@style/Widget.CiteWise.ProfileToggle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Low"
                    android:checkable="true" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Task List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/tasksRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="8dp"
                tools:listitem="@layout/item_consultant_task_card"
                tools:itemCount="5" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
