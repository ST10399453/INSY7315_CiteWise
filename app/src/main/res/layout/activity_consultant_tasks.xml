<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    tools:context=".ConsultantTasksActivity">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:padding="12dp"
                android:src="@drawable/ic_back_arrow"
                android:contentDescription="Back"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="@font/poppins_extra_bold"
                android:text="Active Tasks"
                android:textColor="@color/gradient_end"
                android:textSize="28sp" />
        </RelativeLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/urgencyFilterGroup"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/toggle_group_track"
            android:clipToPadding="false"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filterAll"
                style="@style/Widget.CiteWise.ProfileToggle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="All"
                android:checkable="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filterUrgent"
                style="@style/Widget.CiteWise.ProfileToggle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Urgent"
                android:checkable="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filterMedium"
                style="@style/Widget.CiteWise.ProfileToggle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Medium"
                android:checkable="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filterLow"
                style="@style/Widget.CiteWise.ProfileToggle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Low"
                android:checkable="true" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Scrollable Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/serviceCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardCornerRadius="20dp"
            app:cardUseCompatPadding="true"
            app:strokeColor="@android:color/transparent"
            app:cardBackgroundColor="@android:color/transparent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/rounded_card_background">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/tasksRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginTop="8dp"
                    tools:listitem="@layout/item_service_review"
                    tools:itemCount="1" />

            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No service requests found"
                android:textColor="@color/gradient_end"
            android:fontFamily="@font/poppins_medium"
            android:textSize="20sp"
            android:gravity="center"
            android:layout_gravity="center"
            android:visibility="gone" />

            <TextView
                android:id="@+id/emptyAll"
                style="@style/EmptyStateText"
                android:text="No requests yet"
                android:visibility="gone"
                android:layout_gravity="center"/>

            <TextView
                android:id="@+id/emptyUrgent"
                style="@style/EmptyStateText"
                android:text="No urgent requests"
                android:visibility="gone"
                android:layout_gravity="center"/>

            <TextView
                android:id="@+id/emptyMedium"
                style="@style/EmptyStateText"
                android:text="No medium priority requests"
                android:visibility="gone"
                android:layout_gravity="center"/>

            <TextView
                android:id="@+id/emptyLow"
                style="@style/EmptyStateText"
                android:text="No low priority requests"
                android:visibility="gone"
                android:layout_gravity="center"/>

        </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
