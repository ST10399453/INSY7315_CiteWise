<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pendingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    tools:context=".PendingApprovalActivity">

    <!-- Card -->
    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:background="@drawable/card_neumorphic_background"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Icon -->
        <ImageView
            android:id="@+id/ivPendingIcon"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="32dp"
            android:src="@drawable/circle_request_success"
            tools:ignore="ContentDescription" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvPendingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Application Under Review"
            android:textSize="20sp"
            android:textAlignment="center"
            android:fontFamily="@font/poppins_sembold"
            android:textColor="@color/gradient_end"
            android:layout_marginBottom="16dp" />

        <!-- Message -->
        <TextView
            android:id="@+id/tvPendingMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thank you for registering as a consultant.\nAn admin will review your profile shortly.\nYou’ll be redirected automatically once approved."
            android:textAlignment="center"
            android:textSize="14sp"
            android:fontFamily="@font/poppins"
            android:textColor="@color/text_faded"
            android:layout_marginBottom="32dp" />

        <!-- Return to Login button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReturnLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:background="@drawable/btn_register"
            android:fontFamily="@font/poppins_bold"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="RETURN TO LOGIN"
            android:textAllCaps="true"
            android:textColor="@color/text_light"
            app:backgroundTint="@null" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
