<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/main_background">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="View all requests - 1"
        android:textSize="16sp"
        android:textColor="@color/text_faded"
        android:paddingTop="40dp"
        android:paddingLeft="24dp"
        android:layout_gravity="start" />

    <!-- Main Content Card -->
    <LinearLayout
        android:layout_width="376dp"
        android:layout_height="360dp"
        android:layout_margin="24dp"
        android:background="@drawable/card_neumorphic_background"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        app:cardCornerRadius="32dp">

            <!-- Service Request Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:paddingLeft="16dp"
                android:fontFamily="@font/poppins_bold"
                android:text="Service Request"
                android:textSize="24sp"
                android:textColor="@color/gradient_end"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Description Text -->
            <TextView
                android:layout_width="370dp"
                android:layout_height="wrap_content"
                android:paddingLeft="16dp"
                android:fontFamily="@font/poppins"
                android:text="Comments will appear on your projects allow others.\nYou can review them if you make changes from the comments."
                android:textSize="12sp"
                android:textColor="@color/text_faded"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="32dp" />

            <!-- Menu Items -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- View all requests -->
                <LinearLayout
                    android:id="@+id/layoutViewAllRequests"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_medium"
                        android:text="View all requests"
                        android:textSize="16sp"
                        android:textColor="@color/text_dark" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="Navigate" />

                </LinearLayout>

                <!-- Recent request progress -->
                <LinearLayout
                    android:id="@+id/layoutRecentProgress"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_medium"
                        android:text="Recent request progress"
                        android:textSize="16sp"
                        android:textColor="@color/text_dark" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="Navigate" />

                </LinearLayout>

                <!-- Request a service -->
                <LinearLayout
                    android:id="@+id/layoutRequestService"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_medium"
                        android:text="Request a service"
                        android:textSize="16sp"
                        android:textColor="@color/text_dark" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="Navigate" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    <!-- Bottom Navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="176dp"
        android:orientation="horizontal"
        android:background="@drawable/card_neumorphic_background"
        android:elevation="8dp"
        android:gravity="center">

        <ImageView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:src="@drawable/ic_home"
            android:scaleType="centerInside"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Home" />

        <ImageView
            android:id="@+id/navPhone"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:src="@drawable/ic_phone"
            android:scaleType="centerInside"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Phone" />

        <ImageView
            android:id="@+id/navMessage"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:src="@drawable/ic_trends"
            android:scaleType="centerInside"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Messages" />

        <ImageView
            android:id="@+id/navCalendar"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:src="@drawable/ic_calendar"
            android:scaleType="centerInside"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Calendar" />

        <ImageView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:src="@drawable/ic_profile"
            android:scaleType="centerInside"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Profile" />

    </LinearLayout>

</LinearLayout>