<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_card_background"
    android:layout_marginBottom="12dp"
    android:padding="16dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/taskServiceType"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/text_dark"
        android:textSize="16sp"
        android:fontFamily="@font/poppins_sembold"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/taskUrgencyTag"
        tools:text="Proofreading &amp; Editing" />

    <TextView
        android:id="@+id/taskUrgencyTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_light"
        android:textSize="12sp"
        android:fontFamily="@font/poppins_sembold"
        android:paddingHorizontal="10dp"
        android:paddingVertical="2dp"
        android:background="@drawable/priority_tag_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Low"
        tools:backgroundTint="@color/priority_Low"/>

    <TextView
        android:id="@+id/taskDocumentName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/text_dark"
        android:textSize="14sp"
        android:fontFamily="@font/poppins_medium"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/taskServiceType"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Business Report" />

    <ProgressBar
        android:id="@+id/taskProgressBar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:progressDrawable="@drawable/custom_progress_bar"
        android:layout_marginTop="12dp"
        android:max="100"
        app:layout_constraintTop_toBottomOf="@id/taskDocumentName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/taskProgressPercent"
        tools:progress="50" />

    <TextView
        android:id="@+id/taskProgressPercent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/gradient_end"
        android:textSize="12sp"
        android:fontFamily="@font/poppins_medium"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="@id/taskProgressBar"
        app:layout_constraintBottom_toBottomOf="@id/taskProgressBar"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="50%" />

    <TextView
        android:id="@+id/taskStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_faded"
        android:textSize="12sp"
        android:fontFamily="@font/poppins"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/taskProgressBar"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="In Progress" />

    <TextView
        android:id="@+id/taskDeadline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_faded"
        android:textSize="12sp"
        android:fontFamily="@font/poppins"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/taskProgressBar"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Deadline: 28/11/2025" />

</androidx.constraintlayout.widget.ConstraintLayout>