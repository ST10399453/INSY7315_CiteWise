<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootAdmin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F9">

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/adminContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp">

                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="32dp"
                    android:layout_height="26dp"
                    android:src="@drawable/hamburger"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Menu"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Greeting Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/greetingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="@android:color/transparent"
                app:cardBackgroundColor="@android:color/transparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_greeting_card"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:baselineAligned="false"
                        tools:ignore="UseCompoundDrawables">

                        <TextView
                            android:id="@+id/tvGreeting"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/public_sans_bold"
                            android:letterSpacing="0.01"
                            android:text="Hi"
                            android:textColor="@color/text_light"
                            android:textSize="30sp" />

                        <ImageView
                            android:id="@+id/logoIcon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginTop="-4dp"
                            android:src="@drawable/logo"
                            app:tint="@android:color/white"
                            android:contentDescription="@string/app_name" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/subtitleText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="8dp"
                        android:text="Here’s what’s happening with your team today."
                        android:textColor="#E0EBECF0"
                        android:textSize="16sp"
                        android:fontFamily="@font/public_sans_medium" />

                    <!-- small chips -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:id="@+id/chipTotalConsultants"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="30 Total Consultants"
                            android:textColor="@color/gradient_middle"
                            android:fontFamily="@font/poppins_medium"
                            android:background="@drawable/btn_login"
                            android:textSize="12sp"
                            android:visibility="gone"/>

                        <TextView
                            android:id="@+id/chipActiveToday"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp"
                            android:text="24 Active Today"
                            android:textColor="@color/gradient_middle"
                            android:fontFamily="@font/poppins_medium"
                            android:background="@drawable/btn_login"
                            android:textSize="12sp"
                            android:visibility="invisible"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- KPI Row -->
            <LinearLayout
                android:id="@+id/kpiRow1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <!-- Total Consultants -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTotalConsultants"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="20dp"
                    app:cardUseCompatPadding="true"
                    app:strokeColor="@android:color/transparent"
                    app:cardBackgroundColor="@android:color/transparent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/card_neumorphic_background"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Total Consultants"
                                android:textColor="@color/text_dark"
                                android:textSize="18sp"
                                android:fontFamily="@font/public_sans_medium" />

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_total_consultants"
                                android:contentDescription="@string/app_name" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvConsultantsValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30"
                            android:textColor="@color/text_dark"
                            android:textSize="28sp"
                            android:fontFamily="@font/public_sans_bold"
                            android:layout_marginTop="6dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Total Students -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTotalStudents"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="20dp"
                    app:cardUseCompatPadding="true"
                    app:strokeColor="@android:color/transparent"
                    app:cardBackgroundColor="@android:color/transparent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/card_neumorphic_background"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Total Students"
                                android:textColor="@color/text_dark"
                                android:textSize="18sp"
                                android:fontFamily="@font/public_sans_medium" />

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_total_students"
                                android:contentDescription="@string/app_name" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvStudentsValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="127"
                            android:textColor="@color/text_dark"
                            android:textSize="28sp"
                            android:fontFamily="@font/public_sans_bold"
                            android:layout_marginTop="6dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Total Active Tasks with PieChart -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardActiveTasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="20dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="@android:color/transparent"
                app:cardBackgroundColor="@android:color/transparent">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_neumorphic_background"
                    android:padding="16dp"
                    tools:ignore="UselessParent">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvActiveTasksTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Total Active Tasks"
                        android:textColor="@color/text_dark"
                        android:textSize="22sp"
                        android:fontFamily="@font/public_sans_medium"
                        android:layout_toStartOf="@id/ivTasksInfo" />

                    <ImageView
                        android:id="@+id/ivTasksInfo"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="2dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_info" />

                    <TextView
                        android:id="@+id/tvActiveTasksCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/text_dark"
                        android:textSize="28sp"
                        android:fontFamily="@font/public_sans_bold"
                        android:layout_below="@id/tvActiveTasksTitle"
                        android:layout_marginTop="6dp" />

                    <!-- Real pie chart -->
                    <com.github.mikephil.charting.charts.PieChart
                        android:id="@+id/pieActiveTasks"
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:layout_alignParentEnd="true"
                        android:layout_below="@id/tvActiveTasksTitle"
                        android:layout_marginTop="8dp" />

                    <!-- Legend (custom text, chart legend disabled) -->
                    <LinearLayout
                        android:id="@+id/tasksLegend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_below="@id/tvActiveTasksCount"
                        android:layout_alignParentStart="true"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:id="@+id/tvLegendSubmitted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Submitted (0)"
                            android:textColor="@color/text_faded"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins" />

                        <TextView
                            android:id="@+id/tvLegendAssigned"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Assigned (0)"
                            android:textColor="@color/text_faded"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins" />

                        <TextView
                            android:id="@+id/tvLegendCompleted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Completed (0)"
                            android:textColor="@color/text_faded"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins" />
                    </LinearLayout>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Top Consultants -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTopConsultants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="20dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="@android:color/transparent"
                app:cardBackgroundColor="@android:color/transparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_neumorphic_background"
                    android:padding="16dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tvTopConsultants"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Top Consultants"
                            android:paddingStart="12dp"
                            android:paddingTop="8dp"
                            android:textColor="#000"
                            android:textSize="22sp"
                            android:fontFamily="@font/public_sans_medium"
                            android:layout_toStartOf="@id/icTop"
                            tools:ignore="RtlSymmetry" />

                        <ImageView
                            android:id="@+id/icTop"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_alignParentEnd="true"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_trophy"
                            android:contentDescription="@string/app_name" />
                    </RelativeLayout>

                    <!-- Empty state for Top Consultants (hidden by default) -->
                    <!-- Empty state for Top Consultants (hidden by default) -->
                    <TextView
                        android:id="@+id/emptyTopConsultants"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="No top consultants yet"
                        android:textAlignment="center"
                        android:textColor="@color/text_faded"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins_medium"
                        android:visibility="gone" />

                    <!-- RecyclerView list -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvTopConsultants"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_top_consultant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pending Consultants -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPendingConsultants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="20dp"
                app:cardUseCompatPadding="true"
                app:strokeColor="@android:color/transparent"
                app:cardBackgroundColor="@android:color/transparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_neumorphic_background"
                    android:padding="16dp"
                    android:visibility="gone">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tvPendingConsultants"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Pending Consultants"
                            android:paddingStart="12dp"
                            android:paddingTop="8dp"
                            android:textColor="#000"
                            android:textSize="22sp"
                            android:fontFamily="@font/public_sans_medium"
                            android:layout_toStartOf="@id/icPendingTitle"
                            tools:ignore="RtlSymmetry" />

                        <ImageView
                            android:id="@+id/icPendingTitle"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_alignParentEnd="true"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_pending"
                            android:contentDescription="@string/app_name" />
                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/listPending"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Screen-level loading spinner (hidden by default) -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressRequests"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:visibility="gone"
                app:indicatorSize="40dp"
                app:trackThickness="4dp"
                app:indicatorColor="@color/gradient_end"
                app:trackColor="@color/light_highlight" />

            <!-- Empty state -->
            <TextView
                android:id="@+id/emptyRequests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:paddingTop="8dp"
                android:text="No items yet"
                android:textAlignment="center"
                android:textColor="@color/text_faded"
                android:fontFamily="@font/poppins_medium"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
