<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fillViewport="true"
    android:padding="24dp"
    tools:context=".PasswordResetActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/reset_password_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_medium"
            android:textColor="@color/primary_blue"
            android:paddingBottom="8dp"/>

        <!-- New Password label ABOVE field -->
        <TextView
            android:id="@+id/tvNewPasswordLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:labelFor="@id/etNewPassword"
            android:text="@string/new_password"
            android:textColor="@color/primary_blue_dark"
            android:textStyle="bold"
            android:textSize="14sp"
            android:fontFamily="@font/poppins"/>

        <!-- New Password input (outlined, no floating hint) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNewPassword"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:hintEnabled="false"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="@color/primary_blue_dark"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/primary_blue_dark">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNewPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:imeOptions="actionNext"
                android:fontFamily="@font/poppins"
                android:background="@drawable/outline_edittext"
                android:textColor="@color/black"
                android:hint="@string/new_password"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Confirm Password label ABOVE field -->
        <TextView
            android:id="@+id/tvConfirmPasswordLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@id/etConfirmPassword"
            android:text="@string/confirm_new_password"
            android:textColor="@color/primary_blue_dark"
            android:textStyle="bold"
            android:textSize="14sp"
            android:fontFamily="@font/poppins"/>

        <!-- Confirm Password input (outlined, no floating hint) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilConfirmPassword"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:hintEnabled="false"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="@color/primary_blue_dark"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/primary_blue_dark">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:imeOptions="actionDone"
                android:fontFamily="@font/poppins"
                android:textColor="@color/black"
                android:background="@drawable/outline_edittext"
                android:hint="@string/confirm_new_password"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Primary CTA (gradient blue) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmReset"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/verify_and_set_password"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_sembold"
            android:background="@drawable/button_gradient_blue"
            app:backgroundTint="@null"
            android:enabled="false"
            android:stateListAnimator="@null"/>

        <!-- Progress -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:visibility="gone"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
