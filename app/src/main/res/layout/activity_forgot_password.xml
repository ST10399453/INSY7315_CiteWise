<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_background"
    tools:context=".ForgotPasswordActivity">

    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="360dp"
        android:layout_height="424dp"
        android:layout_margin="24dp"
        android:background="@drawable/card_neumorphic_background"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:cardCornerRadius="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Title -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/reset_password_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_medium"
            android:textColor="@color/gradient_end"
            android:paddingTop="10dp"/>

        <!-- Subtitle -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvSubtitle"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:layout_marginBottom="8dp"
            android:padding="8dp"
            android:text="@string/reset_password_subtitle"
            android:textSize="14sp"
            android:textAlignment="center"
            android:fontFamily="@font/poppins"
            android:textColor="@color/text_faded"/>

        <!-- Static label ABOVE the textbox -->
        <TextView
            android:id="@+id/tvEmailLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:layout_marginHorizontal="24dp"
            android:labelFor="@id/etEmail"
            android:text="@string/email"
            android:textColor="@color/gradient_end"
            android:textStyle="bold"
            android:textSize="14sp"
            android:fontFamily="@font/poppins"/>


            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="328dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="64dp"
                android:layout_gravity="center"
                android:background="@drawable/text_field"
                android:fontFamily="@font/poppins"
                android:padding="12dp"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="20dp"
                android:textColor="@color/text_faded"
                android:textSize="14sp"
                android:hint="you@example.com"
                tools:text="ethan@example.com"/>

        <!-- Primary CTA (gradient blue) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendEmailLink"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_margin="8dp"
            android:background="@drawable/btn_register"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textAllCaps="true"
            android:textColor="@color/text_light"
            app:backgroundTint="@null"
            android:layout_gravity="center"
            android:text="@string/send_reset_link"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_sembold"
            android:enabled="false"
            android:stateListAnimator="@null"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
