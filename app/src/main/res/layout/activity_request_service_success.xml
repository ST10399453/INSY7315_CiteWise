<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    tools:context=".RequestServiceSuccessActivity">

    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="0dp"
        android:layout_height="400dp"
        android:layout_margin="24dp"
        android:background="@drawable/card_neumorphic_background"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:cardCornerRadius="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_margin="24dp"
            android:layout_marginBottom="40dp"
            android:src="@drawable/circle_request_success"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Your request has been \n submitted"
            android:textSize="20sp"
            android:textAlignment="center"
            android:fontFamily="@font/poppins_sembold"
            android:textColor="@color/gradient_end"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="A quotation will be generated \n after submission."
            android:textSize="14sp"
            android:textAlignment="center"
            android:fontFamily="@font/poppins"
            android:textColor="@color/text_faded"/>


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>