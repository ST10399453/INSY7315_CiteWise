<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@color/ui_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upload Feedback"
            android:textColor="@color/gradient_end"
            android:fontFamily="@font/public_sans_medium"
            android:textStyle="bold"
            android:textSize="22sp"
            android:layout_marginBottom="12dp"
            android:gravity="center" />

        <!-- File picker card -->
        <LinearLayout
            android:id="@+id/cardPicker"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_dashed_border"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_file_upload"
                app:tint="@color/gradient_end"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/txtSelectFile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to choose a file"
                android:textColor="#757575"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_medium" />
        </LinearLayout>

        <!-- Selected file name (readonly preview) -->
        <TextView
            android:id="@+id/tvPickedName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@null"
            android:textColor="@color/text_dark"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_medium"
            android:layout_marginTop="10dp" />

        <!-- Desired file name input -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="File name"
            android:textColor="@color/text_dark"
            android:fontFamily="@font/poppins_medium"
            android:textSize="14sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etFileName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/text_field"
            android:hint="e.g. annotated.pdf"
            android:fontFamily="@font/poppins"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_dark"
            android:textColorHint="@android:color/darker_gray"
            android:textSize="14sp" />

        <!-- Upload button + progress -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpload"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="UPLOAD"
                android:textAllCaps="false"
                android:textColor="@color/text_light"
                android:background="@drawable/btn_register"
                app:backgroundTint="@null" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
