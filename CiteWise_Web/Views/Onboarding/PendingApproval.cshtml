@{
    ViewData["Title"] = "Registration Pending";
}

<style>
    body {
        background-color: #f8f9fc;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .pending-container {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
        text-align: center;
        color: #333;
        padding: 2rem;
    }

    .pending-box {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        padding: 3rem 4rem;
        max-width: 600px;
        width: 90%;
        background: #EBECF0;
        border-radius: 16px;
        padding: 24px 32px;
        box-shadow: 4px 4px 4.1px 0 rgba(0, 0, 0, 0.25) inset, -4px -4px 4px 0 rgba(255, 255, 255, 0.63) inset, 2px 2px 4px 0 rgba(0, 0, 0, 0.2), -1px -1px 2px 0 rgba(255, 255, 255, 0.5);
    }

        .pending-box h2 {
            font-weight: 700;
            color: #0027B2;
            margin-bottom: 1rem;
        }

        .pending-box p {
            color: #555;
            font-size: 1.1rem;
            margin-bottom: 2rem;
        }

    .btn-primary {
        background: linear-gradient(135deg, #0027B2 0%, #02134D 100%);
        box-shadow: inset 0 0 15px rgba(193, 200, 223, 0.4), 0 10px 20px rgba(0, 0, 0, 0.2);
        border: none;
        border-radius: 8px;
        padding: 0.75rem 1.5rem;
        color: #fff;
        font-weight: 600;
        text-decoration: none;
        transition: background-color 0.3s ease;
    }

        .btn-primary:hover {
            background: #0027B2;
            box-shadow: -4px -4px 4px 0 #fff inset, 5px 5px 2px 0 rgba(0, 0, 0, 0.12) inset;
        }

    .status-icon {
        font-size: 60px;
        color: #0027B2;
        margin-bottom: 1rem;
    }

</style>


<div class="pending-container">
    <div class="pending-box">
        <div class="status-icon">
            <!-- Static Hourglass Icon -->
            <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="#ffc107" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 2h12v2l-4 4 4 4v2H6v-2l4-4-4-4V2z" />
                <line x1="6" y1="22" x2="18" y2="22" />
            </svg>
        </div>
        <h2>Your consultant registration is pending approval.</h2>
        <p>Please wait for an administrator to review and approve your account.</p>
        <a href="/Account/Login" class="btn btn-primary">Return to Login</a>
    </div>
</div>
