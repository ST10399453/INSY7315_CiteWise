@model CiteWise_Web.Models.ServiceRequest.ServiceRequest

@{
    Layout = "_LayoutAuth";
}


<h2>Submit Service Request</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<form asp-action="StudentServiceRequest" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label for="SelectedService">Service</label>
        <select asp-for="SelectedService" class="form-control" required>
            <option value="">-- Select Service --</option>
            <option>Proofreading & Editing</option>
            <option>Formatting & Referencing</option>
            <option>Data Analysis Support</option>
            <option>Research Methodology Coaching</option>
            <option>Translation</option>
            <option>Other</option>
        </select>
        <span asp-validation-for="SelectedService" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="AdditionalInfo">Additional Information</label>
        <textarea asp-for="AdditionalInfo" class="form-control"></textarea>
        <span asp-validation-for="AdditionalInfo" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="Documents">Upload Document</label>
        <input type="file" asp-for="Documents" class="form-control" required />
        <span asp-validation-for="Documents" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="Urgency">Urgency</label><br />
        <input type="radio" asp-for="Urgency" value="Low" /> Low
        <input type="radio" asp-for="Urgency" value="Medium" /> Medium
        <input type="radio" asp-for="Urgency" value="High" /> High
        <span asp-validation-for="Urgency" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="Deadline">Deadline (optional)</label>
        <input type="date" asp-for="Deadline" class="form-control" />
        <span asp-validation-for="Deadline" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary mt-2">Submit Request</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}