@model CiteWise_Web.Models.ServiceRequest.ServiceRequest
@{
    Layout = "_LayoutAuth";
}

<div class="wizard-container p-5 bg-white rounded-3 shadow-lg">
    <h2 class="mb-4 text-center">Submit Service Request</h2>

    <form asp-action="StudentServiceRequest" method="post" enctype="multipart/form-data">

        <!-- STEP 1: SERVICE REQUEST -->
        <div id="step1" class="wizard-step">
            <h4>Step 1: Select Service</h4>
            <select asp-for="SelectedService" class="form-control mb-3">
                <option value="">-- Select a Service --</option>
                <option value="Formatting & Referencing">Formatting & Referencing</option>
                <option value="Research/Methodology Coaching">Research/Methodology Coaching</option>
                <option value="Language Editing">Language Editing</option>
            </select>
            <button type="button" class="btn btn-primary float-end" onclick="nextStep(2)">Next</button>
        </div>

        <!-- STEP 2: ADDITIONAL INFO -->
        <div id="step2" class="wizard-step" style="display:none;">
            <h4>Step 2: Additional Information</h4>
            <textarea asp-for="AdditionalInfo" class="form-control mb-3" rows="4"
                      placeholder="Provide any specific instructions or details about your request"></textarea>
            <button type="button" class="btn btn-secondary" onclick="prevStep(1)">Back</button>
            <button type="button" class="btn btn-primary float-end" onclick="nextStep(3)">Next</button>
        </div>

        <!-- STEP 3: UPLOAD DOCUMENT -->
        <div id="step3" class="wizard-step" style="display:none;">
            <h4>Step 3: Upload Your Document</h4>
            <input asp-for="Documents" type="file" class="form-control mb-3" />
            <button type="button" class="btn btn-secondary" onclick="prevStep(2)">Back</button>
            <button type="button" class="btn btn-primary float-end" onclick="nextStep(4)">Next</button>
        </div>

        <!-- STEP 4: DEADLINE & URGENCY -->
        <div id="step4" class="wizard-step" style="display:none;">
            <h4>Step 4: Set Deadline & Urgency</h4>

            <label class="form-label">Deadline</label>
            <input asp-for="Deadline" type="date" class="form-control mb-3" />

            <label class="form-label">Urgency Level</label>
            <select asp-for="Urgency" class="form-control mb-3">
                <option value="">-- Select Urgency --</option>
                <option value="Low">Low</option>
                <option value="Medium">Medium</option>
                <option value="High">High</option>
            </select>

            <button type="button" class="btn btn-secondary" onclick="prevStep(3)">Back</button>
            <button type="submit" class="btn btn-success float-end">Submit Request</button>
        </div>

    </form>
</div>

