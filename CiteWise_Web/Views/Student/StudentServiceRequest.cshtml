@model CiteWise_Web.Models.ServiceRequest.ServiceRequest
@{
    Layout = "_LayoutAuth";
}

<div class="studentbody">
    <div class="centered">
        <h2 class="page-title">Request a Service</h2>
        <div class="progress-bar">
            <div class="progress-fill" style="width: 0%;"></div>
        </div>

        <div class="studentcard">
            <form asp-action="StudentServiceRequest" method="post" enctype="multipart/form-data" class="register-form">

                @* STEP 1 *@
                <div id="step1">
                    <h3>Step 1: Select a service</h3>
                    <div class="form-group">
                        <label>
                            <input type="radio" asp-for="SelectedService" value="PROOFREADING_EDITING" />Proofreading & Editing
                        </label><br>
                        <label>
                            <input type="radio" asp-for="SelectedService" value="FORMATTING_REFERENCING" />Formatting & Referencing
                        </label><br>
                        <label>
                            <input type="radio" asp-for="SelectedService" value="DATA_ANALYSIS_SUPPORT" />Data Analysis Support
                        </label><br>
                        <label>
                            <input type="radio" asp-for="SelectedService" value="RESEARCH_METHODOLOGY_COACHING" />Research/Methodology Coaching
                        </label><br>
                        <label>
                            <input type="radio" asp-for="SelectedService" value="TRANSLATION" />Translation
                        </label><br>

                        <span asp-validation-for="SelectedService" class="text-dangers"></span>
                        @* <button type="button" class="btn btn-primary float-end" onclick="nextStep(2)">Next</button> *@
                     </div>
                    <div class="button-container">
                        <button type="button" class="btn-next" onclick="nextStep(2)">Next</button>
                    </div>
                </div>

                @* STEP 2 *@
                <div id="step2" style="display:none">
                    <h3>Step 2: Fill out any additional information</h3>

                    <div class="form-group">
                        <label>Project Name</label>
                        <input asp-for="ProjectTitle" class="icon-input" placeholder="Enter project name..." />
                        <span asp-validation-for="ProjectTitle" class="text-dangers"></span>
                    </div>

                    <textarea asp-for="AdditionalInfo" rows="3" class="custom-textarea"  placeholder="Additional info..."></textarea>
                    <div class="button-container">
                        <button type="button" class="btn-next" onclick="nextStep(3)">Next</button>
                    </div>
                    @* ADD PREVIOUS BTN *@
                </div>

                @* STEP 3 *@
                <div id="step3" style="display:none">
                    <h3>Step 3: Upload Your Document</h3>
                    <div class="form-group">
                        <label>Document Name</label>
                        <input asp-for="DocName" type="text" id="docName" class="icon-input" placeholder="Enter document name" />
                        <span asp-validation-for="DocName" class="text-dangers"></span>
                    </div>

                    <div class="form-group">
                        <label>Document</label>
                        <label class="file-upload-container" for="documentUpload">
                            <img src="/icons/file_upload.svg" alt="Upload" class="upload-icon" />
                            <div class="upload-text">
                                <span class="upload-lines"></span>
                                <span class="upload-label">Select a file</span>
                                <span class="upload-lines"></span>
                            </div>
                            <input asp-for="Documents" type="file" id="documentUpload" class="file-input-hidden" />
                        </label>
                        <div id="selectedFileName" class="selected-file-name"></div>
                        <span asp-validation-for="Documents" class="text-dangers"></span>
                    </div>
                    <div class="button-container">
                        <button type="button" class="btn-next" onclick="nextStep(4)">Next</button>
                    </div>
                </div>

                @* STEP 4 *@
                <div id="step4" style="display:none">
                    <h3>Step 4: Level of Urgency</h3>
                    <div class="form-group">
                        <label>Enter Deadline</label>
                        <div class="input-with-icon">
                            <input asp-for="Deadline" type="text" class="icon-input" id="deadlinePicker" placeholder="Enter deadline" />
                            <svg class="input-icon calendar-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                Replace this with your actual calendar SVG
                                <rect x="3" y="4" width="18" height="18" rx="2" stroke="#0027B2" stroke-width="2" />
                                <line x1="16" y1="2" x2="16" y2="6" stroke="#0027B2" stroke-width="2" stroke-linecap="round" />
                                <line x1="8" y1="2" x2="8" y2="6" stroke="#0027B2" stroke-width="2" stroke-linecap="round" />
                                <line x1="3" y1="10" x2="21" y2="10" stroke="#0027B2" stroke-width="2" />
                            </svg>
                        </div>
                        <span asp-validation-for="Deadline" class="text-dangers"></span>
                    </div>
                    
                    <br/>
                    @* <div class="form-group">
                        <label>Urgency Level</label>
                        <div class="input-with-icon">
                            <select asp-for="Urgency" class="icon-input">
                                <option value="">-- Select Urgency --</option>
                                <option value="LOW">Low</option>
                                <option value="MEDIUM">Medium</option>
                                <option value="HIGH">High</option>
                            </select>
                            <svg class="input-icon arrow-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M6 9L12 15L18 9" stroke="#0027B2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </div>
                        <span asp-validation-for="Urgency" class="text-dangers"></span>
                    </div> *@
                    <!-- Replace your current Step 4 urgency dropdown section with this -->

                    <div class="form-group">
                        <label>Urgency Level</label>

                        <!-- Hidden select for ASP.NET form binding -->
                        <select asp-for="Urgency" class="icon-input"  style="display: none;" id="urgencySelect">
                            <option value="">-- Select Urgency --</option>
                            <option value="LOW">Low</option>
                            <option value="MEDIUM">Medium</option>
                            <option value="HIGH">High</option>
                        </select>

                        <!-- Custom dropdown UI -->
                        <div class="custom-dropdown" id="urgencyDropdown">
                            <div class="dropdown-selected">
                                <span class="selected-text">-- Select Urgency --</span>
                                <svg class="dropdown-arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M6 9L12 15L18 9" stroke="#0027B2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </div>

                            <div class="dropdown-options">
                                <div class="dropdown-option" data-value="HIGH">
                                    <div class="option-content">
                                        <span class="urgency-indicator high"></span>
                                        <span class="option-text"><strong>HIGH</strong> (urgent)</span>
                                    </div>
                                    <svg class="check-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M20 6L9 17L4 12" stroke="#0027B2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </div>

                                <div class="dropdown-option" data-value="MEDIUM">
                                    <div class="option-content">
                                        <span class="urgency-indicator medium"></span>
                                        <span class="option-text"><strong>MEDIUM</strong> (important but not urgent)</span>
                                    </div>
                                    <svg class="check-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M20 6L9 17L4 12" stroke="#0027B2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </div>

                                <div class="dropdown-option" data-value="LOW">
                                    <div class="option-content">
                                        <span class="urgency-indicator low"></span>
                                        <span class="option-text"><strong>LOW</strong> (not urgent)</span>
                                    </div>
                                    <svg class="check-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M20 6L9 17L4 12" stroke="#0027B2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    </svg>
                                </div>
                            </div>
                        </div>

                        <span asp-validation-for="Urgency" class="text-dangers"></span>
                    </div>

                    <div class="button-container">
                        <button type="submit" class="btn-next">Submit</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}