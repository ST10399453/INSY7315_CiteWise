@model List<CiteWise_Web.Models.ServiceRequest.ServiceRequestItem>
@{
    Layout = "_LayoutAuth";
    var selectedPriority = (string)Context.Request.Query["priority"] ?? "All";
}


@{
    ViewData["Title"] = "Manage Consultants";
    var pending = ViewBag.Pending as List<CiteWise_Web.Models.ConsultantItem>;
    var approved = ViewBag.Approved as List<CiteWise_Web.Models.ConsultantItem>;
    var consultants = ViewBag.Consultants as List<CiteWise_Web.Models.ConsultantItem>;
    var students = ViewBag.Students as List<CiteWise_Web.Models.Account.UserProfile>;

}


@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}



@* <div class="dashboard-header">
    <h2>Consultant management</h2>
    <br />
    <p>Manage consultants and their information.</p>
</div>
 *@



<div class="studentbody">
    <div class="centered">
        <h2 class="page-title">Consultant Management</h2>


        <div class="filter-tabs">
            <div class="active-bg"></div>
            <a class="tab @(selectedPriority == "All" ? "active" : "")" data-priority="All">All</a>
            <a class="tab @(selectedPriority == "High" ? "active" : "")" data-priority="High">High</a>
            <a class="tab @(selectedPriority == "Medium" ? "active" : "")" data-priority="Medium">Medium</a>
            <a class="tab @(selectedPriority == "Low" ? "active" : "")" data-priority="Low">Low</a>
        </div>

        <div class="dashboard-card">
            @if (!Model.Any())
            {
                <p>No unassigned service requests found.</p>
            }
            else
            {
                <div class="request-list">
                    @foreach (var req in Model)
                    {
                        <div class="request-item">
                            <div class="category-header d-flex justify-content-between align-items-center">
                                @{
                                    var displayName = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(
                                    req.ServiceType.Replace("_", " ").ToLower()
                                    );

                                    if (displayName.Contains("Proofreading Editing"))
                                        displayName = displayName.Replace("Proofreading Editing", "Proofreading & Editing");

                                    if (displayName.Contains("Formatting Referencing"))
                                        displayName = displayName.Replace("Formatting Referencing", "Formatting & Referencing");
                                }
                                <p class="category-title">@displayName</p>
                                <span class="priority-badge @(req.Priority?.ToLower())">@req.Priority</span>
                            </div>

                            <div class="request-content">
                                <div class="content-left">
                                    <h3 class="request-title">@(req.DocumentName ?? "-")</h3>
                                    <p class="submission-date">
                                        Deadline: @(string.IsNullOrEmpty(req.Deadline) ? "-" : req.Deadline)
                                    </p>

                                    <div class="request-footer d-flex justify-content-between align-items-center">
                                        <div>
                                            <form asp-action="Assign" method="post" class="register-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="Id" value="@req.Id" />
                                                <input type="hidden" name="Deadline" value="@req.Deadline" />
                                                <input type="hidden" name="ServiceType" value="@req.ServiceType" />

                                                <select class="form-input" name="consultantId" required>
                                                    <option value="">-- Select Consultant --</option>
                                                    @if (consultants != null && consultants.Any())
                                                    {
                                                        foreach (var c in consultants)
                                                        {
                                                            <option value="@c.Id">@c.Name (@c.Email)</option>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <option disabled>No consultants available</option>
                                                    }
                                                </select>

                                                <button type="submit" class="btn-next">
                                                    Assign
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
