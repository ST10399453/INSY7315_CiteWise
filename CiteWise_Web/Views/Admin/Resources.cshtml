            <th class="text-end">Updated</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            var updatedLocal = r.UpdatedAt?.ToLocalTime();
            <tr>
                <td>@r.Name</td>
                <td>@r.Faculty</td>
                <td>@r.Category</td>
                <td>@r.MimeType</td>
                <td class="text-end">@String.Format("{0:N0}", r.Size) B</td>
                <td class="text-end">@((updatedLocal?.ToString("yyyy-MM-dd HH:mm")) ?? "-")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary"
                       asp-action="DownloadResource"
                       asp-route-id="@r.Id"
                       asp-route-disposition="inline">Open</a>

                    <a class="btn btn-sm btn-outline-secondary"
                       asp-action="DownloadResource"
                       asp-route-id="@r.Id"
                       asp-route-disposition="attachment">Download</a>

                    <form asp-action="DeleteResource" method="post" class="d-inline"
                          onsubmit="return confirm('Delete this resource?');">
                        <input type="hidden" name="id" value="@r.Id" />
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-danger" type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
