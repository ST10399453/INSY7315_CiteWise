@model CiteWise_Web.Models.ViewModels.ConsultantDashboardViewModel

@{
    ViewData["Title"] = "Consultant Dashboard";
    Layout = "_LayoutAuth";
    var selectedPriority = (string)Context.Request.Query["priority"] ?? "All";
}

<!-- Alerts -->
@if (TempData["Message"] != null)
{
    <div class="alert alert-success fade show" id="alertMessage">
        @TempData["Message"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger fade show" id="alertError">
        @TempData["Error"]
    </div>
}


<div class="dashboard-header">
    @* <h2>Good morning, Connor</h2> *@
    <h2>Hi, @(Context.Session.GetString("UserName") ?? "Guest")</h2>
    <br />
    <p>Here's what's happening with your tasks today.</p>
</div>

<div class="resource-section">
    <div class="resource-buttons">
        <a asp-controller="Consultant" asp-action="ViewRequests" class="feature-btn">
            <img src="~/icons/view_requests.png" alt="View all Requests" class="feature-icon" />
            <span>View My Tasks</span>
        </a>
    </div>
</div>


<div class="dashboard-container">
    <div class="consult-grid">

        <div class="dashboard-card">
            <h3 class="dashboard-heading">
                Assigned to me (@(Model?.Assigned?.Count() ?? 0))
            </h3>

            @if (Model?.Assigned == null || !Model.Assigned.Any())
            {
                <p class="text-muted">You haven’t claimed any requests yet.</p>
            }
            else
            {
                <div class="request-list">
                    @foreach (var r in Model.Assigned)
                    {
                        <a asp-action="ServiceRequestDetails" asp-route-id="@r.Id" class="request-item-link">
                            <div class="request-item">
                                <div class="category-header">
                                    @{
                                        var displayName = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(
                                        r.ServiceType.Replace("_", " ").ToLower()
                                        );

                                        if (displayName.Contains("Proofreading Editing"))
                                            displayName = displayName.Replace("Proofreading Editing", "Proofreading & Editing");

                                        if (displayName.Contains("Formatting Referencing"))
                                            displayName = displayName.Replace("Formatting Referencing", "Formatting & Referencing");
                                    }

                                    <p class="category-title">@displayName</p>
                                    <span class="priority-badge @(r.Priority?.ToLower())">@r.Priority</span>
                                </div>

                                <div class="request-content">
                                    <div class="content-left">
                                        <h3 class="request-title">@r.File?.OriginalName</h3>
                                    <p class="submission-date">
                                        Submitted: @(r.CreatedAt.HasValue? r.CreatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy"): "-")
                                    </p>
                                        <div class="request-footer">
                                            <div class="status-group">
                                                <span class="status-dot @(r.Status?.ToLower().Replace(" ", "-"))"></span>
                                                <span class="status-text">@r.Status</span>
                                            </div>
                                            <span class="deadline-text">
                                                Deadline: @(string.IsNullOrEmpty(r.Deadline) ? "-" : r.Deadline)
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            }
        </div>

        <div class="dashboard-card">
            <h3>ddkjdkj</h3>
            </div>


    </div>
</div>
















