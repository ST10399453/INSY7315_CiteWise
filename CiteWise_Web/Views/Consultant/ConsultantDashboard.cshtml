@model CiteWise_Web.Models.ViewModels.ConsultantDashboardViewModel

@{
    ViewData["Title"] = "Consultant Dashboard";
    Layout = "_LayoutAuth";
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="dashboard-container">

    <div class="dashboard-grid">

        <!-- Card: Overview -->
        <div class="dashboard-card">
            <h3>Available Requests</h3>
            <p><strong>@Model.Unassigned.Count</strong> unassigned requests.</p>
            <p>Click "Assign to Me" to claim one.</p>
        </div>

        <!-- Unassigned Requests -->
        <div class="dashboard-card" style="grid-column: span 2;">
            <h3>Unassigned Service Requests</h3>

            <div class="table-scroll">
                @if (!Model.Unassigned.Any())
                {
                    <p style="color:#777;">No unassigned requests at the moment.</p>
                }
                else
                {
                    <table class="table table-striped mt-2">
                        <thead>
                            <tr>
                                <th>Document</th>
                                <th>Service</th>
                                <th>Priority</th>
                                <th>Deadline</th>
                                <th>File</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Unassigned)
                            {
                                <tr>
                                    <td>@r.DocumentName</td>
                                    <td>@r.ServiceType</td>
                                    <td>@r.Priority</td>
                                    <td>@(string.IsNullOrEmpty(r.Deadline) ? "-" : r.Deadline)</td>

                                    <td>
                                        @if (!string.IsNullOrEmpty(r.File?.FileId))
                                        {
                                            <a asp-action="DownloadFile"
                                               asp-route-fileId="@r.File.FileId"
                                               class="btn btn-outline-primary btn-sm">
                                                Download
                                            </a>
                                        }
                                        else
                                        {
                                            <span style="color:#888;">No File</span>
                                        }
                                    </td>

                                    <td>
                                        <form asp-action="AssignToMe" method="post">
                                            <input type="hidden" name="id" value="@r.Id" />
                                            <button type="submit" class="btn btn-success btn-sm">Assign to Me</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <!-- Assigned Requests -->
        <div class="dashboard-card" style="grid-column: span 3;">
            <h3>My Assigned Requests</h3>

            @if (!Model.Assigned.Any())
            {
                <p style="color:#777;">You haven’t claimed any requests yet.</p>
            }
            else
            {
                <table class="table table-hover mt-2">
                    <thead>
                        <tr>
                            <th>Document</th>
                            <th>Service</th>
                            <th>Status</th>
                            <th>Deadline</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Assigned)
                        {
                            <tr>
                                <td>@r.DocumentName</td>
                                <td>@r.ServiceType</td>
                                <td>@r.Status</td>
                                <td>@(string.IsNullOrEmpty(r.Deadline) ? "-" : r.Deadline)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

    </div>
</div>