@{
    ViewData["Title"] = "Consultant Dashboard";
    Layout = "_LayoutAuth";
}

<div class="dashboard-container">
    <h2>Consultant Dashboard</h2>

    <div class="dashboard-grid">

        <!-- Overview Cards -->
        <div class="dashboard-card">
            <h3>My Tasks</h3>
            <p><strong>5 Active Projects</strong></p>
            <p>2 Deadlines this week</p>
            <p>1 Pending Quotation</p>
        </div>

        <!-- Assigned Students -->
        <div class="dashboard-card">
            <h3>Assigned Students</h3>
            <table class="task-table">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>Service</th>
                        <th>Status</th>
                        <th>Deadline</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Connor</td>
                        <td>Proofreading</td>
                        <td>In Progress</td>
                        <td>12 Oct 2025</td>
                        <td>
                           <a asp-controller="Consultant" asp-action="RetrieveRequest" class="btn btn-primary">
                               Open
                           </a>
                        </td>
                    </tr>
                    <tr>
                        <td>Akhilesh</td>
                        <td>Data Analysis</td>
                        <td>Awaiting Feedback</td>
                        <td>15 Oct 2025</td>
                        <td>
                            <a asp-controller="Consultant" asp-action="RetrieveRequest" class="btn btn-primary">
                                Open
                            </a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- File Management -->
        <div class="dashboard-card">
            <h3>File Management</h3>
            <p>Upload annotated document:</p>
            <input type="file" class="file-upload" />
            <button class="btn">Upload</button>
            <p class="mt-2"><a href="#">Download latest student submission</a></p>
        </div>

        <!-- Quotation Handling -->
        <div class="dashboard-card">
            <h3>Quotation Requests</h3>
            <p><strong>Student:</strong> Ethan Huntley</p>
            <p><strong>Service:</strong> Data Analysis</p>
            <p><strong>Suggested Quote:</strong> R650.00</p>
            <div class="btn-group">
                <button class="btn">Approve</button>
                <button class="btn btn-secondary">Revise</button>
            </div>
        </div>

        <!-- Messages -->
        <div class="dashboard-card">
            <h3>Messages</h3>
            <ul class="message-list">
                <li><strong>Erin:</strong> Thanks for the feedback!</li>
                <li><strong>Alicia:</strong> Uploaded my draft.</li>
            </ul>
            <button class="btn">Go to Messages</button>
        </div>

    </div>
</div>
