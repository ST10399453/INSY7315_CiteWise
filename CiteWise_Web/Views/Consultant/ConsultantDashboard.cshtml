@{
    ViewData["Title"] = "Consultant Dashboard";
    Layout = "_LayoutAuth";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
<div class="dashboard-container">

@* @if (!Model.Any())
{
    <p>No service requests found.</p>
}
