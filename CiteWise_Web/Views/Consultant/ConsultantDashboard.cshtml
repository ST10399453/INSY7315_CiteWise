@model IEnumerable<CiteWise_Web.Models.ServiceRequest.ServiceRequestItem>

<h2>Consultant Dashboard</h2>
<pre>@ViewBag.DebugJson</pre>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <p>No service requests found.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Document</th>
                <th>Service Type</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Deadline</th>
                <th>Consultant</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var req in Model)
            {
                <tr>
                    <td>@req.DocumentName</td>
                    <td>@req.ServiceType</td>
                    <td>@req.Priority</td>
                    <td>@req.Status</td>
                    <td>@req.Deadline</td>
                    <td>@req.ConsultantId</td>
                    <td>
                        @if (string.IsNullOrEmpty(req.ConsultantId))
                        {
                            <form asp-action="AssignToMe" method="post">
                                <input type="hidden" name="id" value="@req.Id" />
                                <button type="submit" class="btn btn-success btn-sm">Assign to Me</button>
                            </form>
                        }
                        else
                        {
                            <span>Assigned</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
