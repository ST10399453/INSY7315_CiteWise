@model CiteWise_Web.Models.LoginModel

<h2>Login</h2>

@* <h2>Login with Google</h2>

<button id="btnGoogleLogin">Sign in with Google</button>

<!-- Firebase Compat SDK -->
<!-- 🔴 BUG SOURCE: compat SDK is used (old version) instead of modular v9 -->
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-auth-compat.js"></script>

<script src="~/js/firebase-login.js"></script> <!-- Custom JS --> *@

<form asp-action="Login" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" />
        <span asp-validation-for="Email"></span>
    </div>

    <div>
        <label asp-for="Password"></label>
        <input asp-for="Password" type="password" />
        <span asp-validation-for="Password"></span>
    </div>

    <button type="submit">Login</button>
    <p class="mt-2">
        <a asp-action="ForgotPassword" asp-controller="Account">Forgot your password?</a>
    </p>
</form>

<button class="btn-google">
    <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="Google Logo">
    Sign in with Google
</button>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}