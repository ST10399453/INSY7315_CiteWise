@using CiteWise_Web.Models.Account
@model RegisterModel

@{
    ViewData["HideLayoutElements"] = true;
}

<div class="register-page">
    <div class="register-container">
        <div class="logo-header">
            <img src="~/img/CiteWise_Logo.jpg" alt="CiteWise Logo" class="logo" />
            <h2 class="app-name">iteWise</h2>
        </div>

        <h2 class="heading">Create an Account</h2>

        <div class="register">
            <div class="forms-stage show-register">
                <div class="form-panel register-panel">
                    <form asp-action="Register" method="post" class="register-form">

                        <div class="form-group">
                            <label asp-for="FirstName"></label>
                            <input asp-for="FirstName" class="form-input" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Surname"></label>
                            <input asp-for="Surname" class="form-input" />
                            <span asp-validation-for="Surname" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Email"></label>
                            <input asp-for="Email" class="form-input" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="form-group password-wrapper">
                            <label asp-for="Password"></label>
                            <div class="password-field">
                                <input asp-for="Password" type="password" class="form-input" id="password" />
                                <button type="button" class="toggle-password" aria-label="Show/Hide Password">
                                    <img src="~/icons/eye_open.svg" class="eye-open" alt="Show Password" />
                                    <img src="~/icons/eye_closed.svg" class="eye-closed" alt="Hide Password" style="display:none;" />
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="form-group password-wrapper">
                            <label asp-for="ConfirmPassword"></label>
                            <div class="password-field">
                                <input asp-for="ConfirmPassword" type="password" class="form-input" id="password" />
                                <button type="button" class="toggle-password" aria-label="Show/Hide Password">
                                    <img src="~/icons/eye_open.svg" class="eye-open" alt="Show Password" />
                                    <img src="~/icons/eye_closed.svg" class="eye-closed" alt="Hide Password" style="display:none;" />
                                </button>
                        </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn-primary">Register</button>

                        <button type="button" class="btn-google">
                            <img src="~/icons/google.svg" alt="Google Icon" />
                            Continue with Google
                        </button>

                        <div class="divider-line"></div>

                        <div class="login-link">
                            Already have an account? <a asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

 @section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
