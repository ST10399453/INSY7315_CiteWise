@{
    ViewData["Title"] = "Create an Account";
}

<div class="register-container">
    <h2 class="text-center">Create an Account</h2>

    <!-- Role Switch -->
    <div class="role-switch">
        <button type="button" class="btn btn-primary active">Student</button>
        <button type="button" class="btn btn-outline-primary">Consultant</button>
    </div>

    <!-- Registration Form -->
    <form asp-action="Register" method="post">
        <div class="form-group">
            <input type="text" class="form-control" placeholder="Name" required />
        </div>
        <div class="form-group">
            <input type="text" class="form-control" placeholder="Surname" required />
        </div>
        <div class="form-group">
            <input type="email" class="form-control" placeholder="Email" required />
        </div>
        <div class="form-group">
            <input type="password" class="form-control" placeholder="Password" required />
        </div>
        <div class="form-group">
            <input type="password" class="form-control" placeholder="Confirm Password" required />
        </div>
        <div class="form-group">
            <input type="text" class="form-control" placeholder="Field of Study" />
        </div>

        <button type="submit" class="btn btn-primary w-100">SIGN UP</button>
    </form>

    <p class="text-center mt-3">
        Already have an account? <a asp-controller="Account" asp-action="Login">Login</a>
    </p>
</div>

