@using CiteWise_Web.Models.Account
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot Password";
    ViewData["HideLayoutElements"] = true;
}

<div class="login-page">
    <div class="register-container">
        <div class="logo-header">
            <img src="~/img/CiteWise_Logo.jpg" alt="CiteWise Logo" class="logo" />
            <h2 class="app-name">iteWise</h2>
        </div>

        <h2 class="heading">Forgot Password</h2>

        <p class="forgot-description">
            Enter your email address below and we'll send you a link to reset your password.
        </p>

        <div class="register">
            <div class="forms-stage show-register">
                <div class="form-panel register-panel">

                   

                    <form asp-action="ForgotPassword" method="post" class="register-form">

                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-group">
                            <label asp-for="Email"></label>
                            <input asp-for="Email" class="form-input" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        @if (ViewBag.SuccessMessage != null)
                        {
                            <div class="text-success">
                                @ViewBag.SuccessMessage
                            </div>
                            <script>
                                setTimeout(function () {
                                    window.location.href = '@Url.Action("Login", "Account")';
                                }, 2000);
                            </script>
                        }
                        <button type="submit" class="btn-primary">Send Reset Link</button>

                        <div class="divider-line"></div>

                        <div class="login-link">
                            <a asp-area="" asp-controller="Account" asp-action="Login">Back to Login</a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .text-success {
        color: #1B5E20;
        background: #E8F5E9;
        border: 1px solid #A5D6A7;
        padding: 10px 12px;
        border-radius: 8px;
        font-family: 'Poppins', sans-serif;
        font-size: 15px;
        margin-bottom: 16px;
        text-align: center;
    }
</style>
