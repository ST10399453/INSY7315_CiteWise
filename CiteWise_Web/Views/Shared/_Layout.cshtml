<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CiteWise_Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>
<body>

    <div class="sidebar">
        @* ADD IMAGE FOR CITEWISE LOGO  *@
        <h2>CiteWise</h2>
        <a href="#" class="active"><i class="fa fa-home"></i> Dashboard</a>
        <a href="#"><i class="fa fa-plus-square"></i> Request a Service</a>
        <a href="#"><i class="fa fa-folder"></i> Academic Resources</a>
        <a href="#"><i class="fa fa-envelope"></i> Messages</a>
        <a href="#"><i class="fa fa-user"></i> Profile</a>
    </div>

    <div class="topbar">
        @* Left side: Greeting *@
        <div class="topbar-left">
            <h2><span>Hi Akhi</span></h2>
        </div>

        @* Right side: Notifications + User *@
        <div class="topbar-right">
            <i class="fa-regular fa-bell icon"></i>
            <a asp-controller="Home" asp-action="Register">
                <img src="https://via.placeholder.com/40" alt="PP"> 
            </a>
        </div>
    </div>


