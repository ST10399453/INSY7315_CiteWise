<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CiteWise_Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/MainApplicationNavBar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/StudentDashboard.css" asp-append-version="true" />
    @* <link rel="stylesheet" href="~/css/register.css" asp-append-version="true" /> *@
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>
<body>
    <div class="sidebar">
        <div class="logo-container">
            <img src="~/img/CiteWise_Logo.jpg" alt="CiteWise Logo" class="sidebar-logo" />
            <h2>iteWise</h2>

            <div class="toggle-btn">
                <img src="~/icons/menu_sidebar.svg" alt="Sidebar expand & collapse" />
            </div>
        </div>

        <div class="logo-divider"></div>

        <a href="#">
            <img src="~/icons/Dashboard.svg" alt="Dashboard" class="sidebar-icon" />
            <span>Dashboard</span>
        </a>

        <a href="#">
            <img src="~/icons/Request.png" alt="Request Service Icon" class="sidebar-icon" />
            <span>Request a Service</span>
        </a>

        <a href="#">
            <img src="~/icons/Resources.svg" alt="Academic Resources" class="sidebar-icon" />
            <span>Academic Resources</span>
        </a>

        <a href="#">
            <img src="~/icons/Messages.svg" alt="Messages" class="sidebar-icon" />
            <span>Messages</span>
        </a>

        <a href="#">
            <img src="~/icons/Profile.svg" alt="Profile" class="sidebar-icon" />
            <span>Profile</span>
        </a>
    </div>

    <div class="topbar">
    <div class="topbar-left">
        <h2 class="topbar-name">
            <span>Hi @(Context.Session.GetString("UserName") ?? "Guest")</span>
        </h2>
    </div>

    <div class="topbar-right">
        <i class="fa-regular fa-bell icon"></i>
        <a asp-controller="Account" asp-action="Logout" title="Logout">
            <img src="https://via.placeholder.com/40" alt="Logout">
        </a>
    </div>
</div>
    <div class="top-divider"></div>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/ServiceRequest.js" asp-append-version="true"></script>

    <script src="https://www.gstatic.com/firebasejs/10.13.0/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.13.0/firebase-auth.js"></script>


    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
