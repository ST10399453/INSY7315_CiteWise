@model CiteWise_Web.Models.Account.ChangePasswordViewModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Change Password";

    var role = Context.Session.GetString("UserRole")?.ToLower();
    var profileAction = role == "admin"
        ? "Admin"
        : role == "consultant"
            ? "Consultant"
            : "Student";
}

<link rel="stylesheet" href="~/css/ProfileSettings.css" asp-append-version="true" />

<div class="profile-back-row">
    <a asp-controller="Profile" asp-action="@profileAction" class="profile-back-link">
        <i class="fa-solid fa-arrow-left"></i>
        <span>Back to profile</span>
    </a>
</div>

<div class="profile-form-card">
    <div class="profile-form-title">Change password</div>
    <div class="profile-form-subtitle">
        Choose a strong password you don't use elsewhere.
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success" role="alert">
            @TempData["Message"]
        </div>
    }

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
    {
        <div class="alert alert-danger" role="alert">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }

    <form asp-action="ChangePassword" method="post">
        @Html.AntiForgeryToken()

        <div class="profile-form-grid">
            <div class="profile-form-group">
                <label asp-for="Email" class="profile-form-label"></label>
                <input asp-for="Email" class="profile-form-input" readonly />
            </div>

            <div></div> <!-- spacer for grid alignment -->
        </div>

        <div class="profile-form-grid">
            <div class="profile-form-group">
                <label asp-for="CurrentPassword" class="profile-form-label"></label>
                <input asp-for="CurrentPassword" class="profile-form-input" />
            </div>

            <div class="profile-form-group">
                <label asp-for="NewPassword" class="profile-form-label"></label>
                <input asp-for="NewPassword" class="profile-form-input" />
                <div class="password-hint">
                    Minimum 6 characters. Use a mix of letters, numbers and symbols.
                </div>
            </div>

            <div class="profile-form-group">
                <label asp-for="ConfirmPassword" class="profile-form-label"></label>
                <input asp-for="ConfirmPassword" class="profile-form-input" />
            </div>
        </div>

        <div class="profile-form-actions">
            <a asp-controller="Profile" asp-action="@profileAction" class="profile-btn-ghost">
                <i class="fa-solid fa-xmark"></i>
                <span>Cancel</span>
            </a>
            <button type="submit" class="profile-btn-primary">
                <i class="fa-solid fa-key"></i>
                <span>Update password</span>
            </button>
        </div>
    </form>
</div>
