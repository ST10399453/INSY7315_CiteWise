@{
    Layout = "_LayoutAuth";
}

<div class="dashboard-container">

    <div class="dashboard-grid">

        <!-- Service Request Progress -->
       <div class="dashboard-card">
            <h3>Service Request Progress</h3>

            <div class="request-list">
                <div class="request-item">
                    <div class="request-header">
                        <p class="request-title">Business Plan Draft</p>
                        <span class="priority-badge low">Low</span>
                    </div>

                    <div class="progress-container">
                        <div class="progress-bar">
                            <div class="progress" style="width:25%"></div>
                        </div>
                    </div>

                    <div class="request-footer">
                        <span class="status-pill">Submitted</span>
                        <span class="status-pill">Deadline: 26.08.2025</span>
                    </div>
                </div>
            </div>

            <button class="btn">Request a Service</button>
            <a class="btn" asp-controller="Dashboard" asp-action="StudentServiceRequest">Request a Service</a>
        </div>


        <!-- Notifications -->
        <div class="dashboard-card">
            <h3>Notifications</h3>
            <ul class="notification-list">
                <li>📄 Missing documents</li>
                <li>✅ Feedback received</li>
                <li>💬 1 New message</li>
                <li>⭐ Rate your consultant</li>
                <li>🔔 Status update</li>
            </ul>
        </div>

        <!-- Service Quote -->
        <div class="dashboard-card">
            <h3>Service Quote</h3>
            <p><strong>Business Plan Draft</strong></p>
            <p>Total: <strong>R450.00</strong></p>
            <p>Deadline: 25.08.2025</p>
            <div class="btn-group">
                <button class="btn">Accept</button>
                <button class="btn btn-secondary">Request Review</button>
                <button class="btn btn-outline">Download PDF</button>
            </div>
        </div>

        <!-- Ask AI Assistant -->
        <div class="dashboard-card">
            <h3>Ask an AI Assistant</h3>
            <p>Our AI assistant is here to help with brainstorming, reviewing and refinement.</p>
        </div>

    </div>
</div>
