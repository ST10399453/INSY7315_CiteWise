@{
    Layout = "_LayoutAuth";
}

<div class="dashboard-container">

    <div class="dashboard-grid">

        <!-- Service Request Progress -->
       <div class="dashboard-card">
    <h3>Service Request Progress</h3>

    <div class="request-list">
        <div class="request-item">
            <p><strong>Business Plan Draft</strong></p>
            <div class="progress-bar"><div class="progress" style="width:25%"></div></div>
            <p class="progress-info">Submitted | Deadline: 26.08.2025</p>
        </div>
        <!-- More... -->
    </div>

    <button class="btn">Request a Service</button>
</div>


        <!-- Notifications -->
        <div class="dashboard-card">
            <h3>Notifications</h3>
            <ul class="notification-list">
                <li>📄 Missing documents</li>
                <li>✅ Feedback received</li>
                <li>💬 1 New message</li>
                <li>⭐ Rate your consultant</li>
                <li>🔔 Status update</li>
            </ul>
        </div>

        <!-- Service Quote -->
        <div class="dashboard-card">
            <h3>Service Quote</h3>
            <p><strong>Business Plan Draft</strong></p>
            <p>Total: <strong>R450.00</strong></p>
            <p>Deadline: 25.08.2025</p>
            <div class="btn-group">
                <button class="btn">Accept</button>
                <button class="btn btn-secondary">Request Review</button>
                <button class="btn btn-outline">Download PDF</button>
            </div>
        </div>

        <!-- Ask AI Assistant -->
        <div class="dashboard-card">
            <h3>Ask an AI Assistant</h3>
            <p>Our AI assistant is here to help with brainstorming, reviewing and refinement.</p>
        </div>

    </div>
</div>
