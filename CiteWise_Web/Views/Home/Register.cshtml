@model CiteWise_Web.Models.UserModel
<div class="register-page">
  <div class="register-container">
    <div class="toggle-container">
      <label for="filter" class="switch" aria-label="Switch between login and register">
        <input type="checkbox" id="filter" />
        <span>Login</span>
        <span>Register</span>
      </label>
    </div>

    <div id="formsStage" class="forms-stage">
      <!-- LOGIN PANEL -->
      <div id="loginForm" class="form-panel login-panel">
        <form asp-action="SignIn" method="post" class="register-form">
          <div class="form-group">
            <label for="Email">Email</label>
            <input asp-for="Email" class="form-control" id="Email" required />
          </div>
          <div class="form-group">
            <label for="Password">Password</label>
            <input asp-for="Password" type="password" class="form-control" id="Password" required />
          </div>
          <button type="submit" class="btn-primary">Sign In</button>
        </form>

        <div class="divider">or</div>

        <button class="btn-google">
          <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="Google Logo">
          Sign in with Google
        </button>
      </div>

      <!-- REGISTER PANEL -->
      <div id="registerForm" class="form-panel register-panel">
        @* <form asp-action="Register" method="post" class="register-form">
          <div class="form-group">
            <label for="FirstName">First Name</label>
            <input asp-for="FirstName" class="form-control" id="FirstName" />
          </div>
          <div class="form-group">
            <label for="Surname">Surname</label>
            <input asp-for="Surname" class="form-control" id="Surname" />
          </div>
          <div class="form-group">
            <label for="EmailReg">Email</label>
            <input asp-for="Email" class="form-control" id="EmailReg" />
          </div>
          <div class="form-group">
            <label for="PasswordReg">Password</label>
            <input asp-for="Password" type="password" class="form-control" id="PasswordReg" />
          </div>
          <button type="submit" class="btn-primary">Register</button>
        </form> *@
                <form asp-action="Register" method="post" class="register-form">

                    <div class="form-group">
                        <label for="Role">Role</label>
                        <select asp-for="Role" class="form-control" id="Role">
                            <option value="">-- Select Role --</option>
                            <option value="student">student</option>
                            <option value="consultant">consultant</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="FirstName">First Name</label>
                        <input asp-for="FirstName" class="form-control" id="FirstName" />
                    </div>

                    <div class="form-group">
                        <label for="Surname">Last Name</label>
                        <input asp-for="Surname" class="form-control" id="Surname" />
