@model CiteWise_Web.Models.UserModel

<div class="register-page">
    <div class="register-container">
        <h2>Sign In</h2>

        <form asp-action="SignIn" method="post" class="register-form">
            <div class="form-group">
                <label for="Email">Email</label>
                <input asp-for="Email" class="form-control" id="Email" />
            </div>
            <div class="form-group">
                <label for="Password">Password</label>
                <input asp-for="Password" type="password" class="form-control" id="Password" />
            </div>

            <button type="submit" class="btn-primary">Sign In</button>
        </form>

        <div class="divider">or</div>

        <button class="btn-google">
            <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="Google Logo">
            Sign in with Google
        </button>

        <div style="margin-top: 20px; font-size: 14px; color: #333;">
            <p>
                Don't have an account?
                <a asp-controller="Home" asp-action="Register">Register here</a>
            </p>
        </div>
    </div>
</div>
